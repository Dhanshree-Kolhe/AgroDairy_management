<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox spacing="20" stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.agrodairy.management.controller.MilkCollectionController">
    <!-- Left Input Counter Panel -->
    <VBox spacing="15" prefWidth="380" styleClass="card">
        <children>
            <Label text="Milk Collection Entry" styleClass="card-title" />
            <Separator />

            <!-- Farmer Code Search -->
            <VBox spacing="5">
                <Label text="Farmer Code" styleClass="form-label" />
                <HBox spacing="10">
                    <TextField fx:id="farmerCodeField" promptText="e.g. FARM-1001" HBox.hgrow="ALWAYS" />
                    <Button text="Search" onAction="#handleSearchFarmer" styleClass="btn-primary" />
                </HBox>
                <Label fx:id="farmerNameLabel" text="Search farmer to begin..." style="-fx-text-fill: #10b981; -fx-font-weight: bold;" />
            </VBox>

            <!-- Shift & Milk Type -->
            <GridPane hgap="10" vgap="10">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50" />
                    <ColumnConstraints percentWidth="50" />
                </columnConstraints>
                <children>
                    <VBox spacing="5" GridPane.columnIndex="0">
                        <Label text="Shift" styleClass="form-label" />
                        <ComboBox fx:id="shiftComboBox" maxWidth="Infinity" />
                    </VBox>
                    <VBox spacing="5" GridPane.columnIndex="1">
                        <Label text="Milk Type" styleClass="form-label" />
                        <ComboBox fx:id="milkTypeComboBox" maxWidth="Infinity" />
                    </VBox>
                </children>
            </GridPane>

            <!-- Quality Inputs -->
            <GridPane hgap="10" vgap="10">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50" />
                    <ColumnConstraints percentWidth="50" />
                </columnConstraints>
                <children>
                    <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label text="Quantity (Liters)" styleClass="form-label" />
                        <TextField fx:id="quantityField" promptText="0.00" />
                    </VBox>
                    <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label text="FAT %" styleClass="form-label" />
                        <TextField fx:id="fatField" promptText="e.g. 4.2" />
                    </VBox>
                    <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <Label text="SNF %" styleClass="form-label" />
                        <TextField fx:id="snfField" promptText="e.g. 8.5" />
                    </VBox>
                    <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <Label text="CLR Reading" styleClass="form-label" />
                        <TextField fx:id="clrField" promptText="e.g. 28.0" />
                    </VBox>
                </children>
            </GridPane>

            <Separator />

            <!-- Rate & Total Summary -->
            <VBox spacing="5" style="-fx-background-color: #f8fafc; -fx-padding: 10; -fx-background-radius: 8;">
                <HBox alignment="CENTER_LEFT">
                    <Label text="Calculated Rate: " style="-fx-font-weight: bold;" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="calculatedRateLabel" text="₹ 0.00 / Litre" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #10b981;" />
                </HBox>
                <HBox alignment="CENTER_LEFT">
                    <Label text="Total Payable: " style="-fx-font-weight: bold;" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="calculatedTotalLabel" text="₹ 0.00" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #0f172a;" />
                </HBox>
            </VBox>

            <Button text="Save &amp; Print Receipt" onAction="#handleSaveCollection" prefHeight="45" maxWidth="Infinity" styleClass="btn-primary" />
        </children>
    </VBox>

    <!-- Right Collections Table Panel -->
    <VBox spacing="15" HBox.hgrow="ALWAYS" styleClass="card">
        <children>
            <Label text="Today's Collection Register" styleClass="card-title" />
            <TableView fx:id="collectionTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="idCol" text="ID" prefWidth="50" />
                    <TableColumn fx:id="codeCol" text="Code" prefWidth="90" />
                    <TableColumn fx:id="nameCol" text="Farmer Name" prefWidth="140" />
                    <TableColumn fx:id="shiftCol" text="Shift" prefWidth="80" />
                    <TableColumn fx:id="typeCol" text="Type" prefWidth="70" />
                    <TableColumn fx:id="qtyCol" text="Qty (L)" prefWidth="70" />
                    <TableColumn fx:id="fatCol" text="FAT" prefWidth="60" />
                    <TableColumn fx:id="snfCol" text="SNF" prefWidth="60" />
                    <TableColumn fx:id="rateCol" text="Rate (₹)" prefWidth="80" />
                    <TableColumn fx:id="totalCol" text="Total (₹)" prefWidth="90" />
                </columns>
            </TableView>
        </children>
    </VBox>
</HBox>
