<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.agrodairy.management.controller.AdminSystemStatusController">
   <content>
      <VBox spacing="20.0">
         <padding>
            <Insets bottom="25.0" left="25.0" right="25.0" top="20.0" />
         </padding>
         <children>
            <!-- Header -->
            <HBox alignment="CENTER_LEFT" spacing="15.0">
               <children>
                  <VBox>
                     <children>
                        <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #0F172A;" text="System Health &amp; Diagnostics" />
                        <Label style="-fx-text-fill: #64748B; -fx-font-size: 13px;" text="Real-time connectivity verification, JVM runtime status, and database repository health checks." />
                     </children>
                  </VBox>
                  <Region HBox.hgrow="ALWAYS" />
                  <Button onAction="#runDiagnostics" styleClass="btn-primary" text="⚡ Run Live Diagnostics Now" />
               </children>
            </HBox>

            <!-- Diagnostics Cards -->
            <VBox spacing="16.0">
               <children>
                  <!-- 1. Database Connectivity Card -->
                  <VBox spacing="12.0" style="-fx-background-color: #FFFFFF; -fx-padding: 20; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.04), 8, 0, 0, 2);">
                     <children>
                        <HBox alignment="CENTER_LEFT">
                           <children>
                              <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" text="🗄️ MySQL Database Connectivity" />
                              <Region HBox.hgrow="ALWAYS" />
                              <Label fx:id="dbStatusBadge" text="CHECKING..." />
                           </children>
                        </HBox>
                        <Separator />
                        <GridPane hgap="15.0" vgap="10.0">
                           <columnConstraints>
                              <ColumnConstraints minWidth="150.0" prefWidth="180.0" />
                              <ColumnConstraints hgrow="ALWAYS" />
                           </columnConstraints>
                           <children>
                              <Label style="-fx-font-weight: bold; -fx-text-fill: #64748B;" text="Target JDBC URL:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                              <Label fx:id="dbUrlLabel" style="-fx-text-fill: #0F172A; -fx-font-family: monospace;" text="jdbc:mysql://localhost:3306/agro_dairy" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                              <Label style="-fx-font-weight: bold; -fx-text-fill: #64748B;" text="Query Ping Latency:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                              <Label fx:id="dbLatencyLabel" style="-fx-text-fill: #0F172A; -fx-font-weight: bold;" text="—" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                              <Label style="-fx-font-weight: bold; -fx-text-fill: #64748B;" text="Connection Pool:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                              <Label style="-fx-text-fill: #0F172A;" text="HikariCP 5.1.0 (Maximum Pool Size: 10, Minimum Idle: 2)" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                           </children>
                        </GridPane>
                     </children>
                  </VBox>

                  <!-- 2. Application Runtime Environment Card -->
                  <VBox spacing="12.0" style="-fx-background-color: #FFFFFF; -fx-padding: 20; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.04), 8, 0, 0, 2);">
                     <children>
                        <HBox alignment="CENTER_LEFT">
                           <children>
                              <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" text="🖥️ Application &amp; JVM Runtime" />
                              <Region HBox.hgrow="ALWAYS" />
                              <Label fx:id="appStatusBadge" text="OPERATIONAL" />
                           </children>
                        </HBox>
                        <Separator />
                        <GridPane hgap="15.0" vgap="10.0">
                           <columnConstraints>
                              <ColumnConstraints minWidth="150.0" prefWidth="180.0" />
                              <ColumnConstraints hgrow="ALWAYS" />
                           </columnConstraints>
                           <children>
                              <Label style="-fx-font-weight: bold; -fx-text-fill: #64748B;" text="Java Runtime / OS:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                              <Label fx:id="jvmVersionLabel" style="-fx-text-fill: #0F172A;" text="Java 17 / Windows" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                              <Label style="-fx-font-weight: bold; -fx-text-fill: #64748B;" text="Session Uptime:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                              <Label fx:id="appUptimeLabel" style="-fx-text-fill: #0F172A;" text="0 min" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                              <Label style="-fx-font-weight: bold; -fx-text-fill: #64748B;" text="JVM Memory Heap:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                              <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                 <children>
                                    <Label fx:id="memoryUsageLabel" style="-fx-text-fill: #0F172A;" text="—" />
                                    <ProgressBar fx:id="memoryProgressBar" maxWidth="350.0" prefHeight="10.0" progress="0.2" />
                                 </children>
                              </VBox>
                           </children>
                        </GridPane>
                     </children>
                  </VBox>

                  <!-- 3. Repository & Data Availability Card -->
                  <VBox spacing="12.0" style="-fx-background-color: #FFFFFF; -fx-padding: 20; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.04), 8, 0, 0, 2);">
                     <children>
                        <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" text="📊 Database Repositories Verification" />
                        <Separator />
                        <GridPane hgap="15.0" vgap="10.0">
                           <columnConstraints>
                              <ColumnConstraints minWidth="150.0" prefWidth="180.0" />
                              <ColumnConstraints hgrow="ALWAYS" />
                           </columnConstraints>
                           <children>
                              <Label style="-fx-font-weight: bold; -fx-text-fill: #64748B;" text="Users Repository:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                              <Label fx:id="usersDataStatusLabel" text="Checking..." GridPane.columnIndex="1" GridPane.rowIndex="0" />

                              <Label style="-fx-font-weight: bold; -fx-text-fill: #64748B;" text="Vendors Repository:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                              <Label fx:id="vendorsDataStatusLabel" text="Checking..." GridPane.columnIndex="1" GridPane.rowIndex="1" />

                              <Label style="-fx-font-weight: bold; -fx-text-fill: #64748B;" text="Customers Repository:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                              <Label fx:id="customersDataStatusLabel" text="Checking..." GridPane.columnIndex="1" GridPane.rowIndex="2" />

                              <Label style="-fx-font-weight: bold; -fx-text-fill: #64748B;" text="Products Repository:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                              <Label fx:id="productsDataStatusLabel" text="Checking..." GridPane.columnIndex="1" GridPane.rowIndex="3" />

                              <Label style="-fx-font-weight: bold; -fx-text-fill: #64748B;" text="Payments Repository:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                              <Label fx:id="paymentsDataStatusLabel" text="Checking..." GridPane.columnIndex="1" GridPane.rowIndex="4" />
                           </children>
                        </GridPane>
                     </children>
                  </VBox>
               </children>
            </VBox>

            <!-- Footer Timestamp -->
            <HBox alignment="CENTER_RIGHT">
               <children>
                  <Label fx:id="lastCheckedLabel" style="-fx-text-fill: #94A3B8; -fx-font-size: 12px;" text="Last Check: Just now" />
               </children>
            </HBox>
         </children>
      </VBox>
   </content>
</ScrollPane>
