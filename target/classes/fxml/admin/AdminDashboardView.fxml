<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.agrodairy.management.controller.AdminDashboardController">
   <content>
      <VBox spacing="20.0">
         <padding>
            <Insets bottom="25.0" left="25.0" right="25.0" top="20.0" />
         </padding>
         <children>
            <!-- Top Controls Bar -->
            <HBox alignment="CENTER_LEFT" spacing="15.0">
               <children>
                  <VBox>
                     <children>
                        <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #0F172A;" text="System Executive Overview" />
                        <Label style="-fx-text-fill: #64748B; -fx-font-size: 13px;" text="Live operational metrics, registered ecosystem accounts, and gross financial ledger." />
                     </children>
                  </VBox>
                  <Region HBox.hgrow="ALWAYS" />
                  <Button onAction="#refreshDashboard" styleClass="btn-primary" text="🔄 Refresh Metrics" />
               </children>
            </HBox>

            <!-- KPI Metric Cards Grid -->
            <GridPane hgap="16.0" vgap="16.0">
               <columnConstraints>
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" percentWidth="25.0" />
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" percentWidth="25.0" />
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" percentWidth="25.0" />
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" percentWidth="25.0" />
               </columnConstraints>
               <rowConstraints>
                  <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
               </rowConstraints>
               <children>
                  <!-- Card 1: Total Users -->
                  <VBox styleClass="kpi-card, card-purple" GridPane.columnIndex="0" GridPane.rowIndex="0">
                     <children>
                        <Label styleClass="kpi-title" text="TOTAL PLATFORM USERS" />
                        <Label fx:id="totalUsersLabel" styleClass="kpi-value" text="0" />
                        <Label styleClass="kpi-subtext" text="Verified database accounts" />
                     </children>
                  </VBox>

                  <!-- Card 2: Total Vendors -->
                  <VBox styleClass="kpi-card, card-blue" GridPane.columnIndex="1" GridPane.rowIndex="0">
                     <children>
                        <Label styleClass="kpi-title" text="ACTIVE VENDORS" />
                        <Label fx:id="totalVendorsLabel" styleClass="kpi-value" text="0" />
                        <Label styleClass="kpi-subtext" text="Operating dairy vendors" />
                     </children>
                  </VBox>

                  <!-- Card 3: Total Customers -->
                  <VBox styleClass="kpi-card, card-green" GridPane.columnIndex="2" GridPane.rowIndex="0">
                     <children>
                        <Label styleClass="kpi-title" text="ACTIVE CUSTOMERS" />
                        <Label fx:id="totalCustomersLabel" styleClass="kpi-value" text="0" />
                        <Label styleClass="kpi-subtext" text="Subscribed households" />
                     </children>
                  </VBox>

                  <!-- Card 4: Total Revenue -->
                  <VBox styleClass="kpi-card, card-orange" GridPane.columnIndex="3" GridPane.rowIndex="0">
                     <children>
                        <Label styleClass="kpi-title" text="TOTAL SYSTEM REVENUE" />
                        <Label fx:id="totalRevenueLabel" styleClass="kpi-value" text="₹0.00" />
                        <Label styleClass="kpi-subtext" text="Verified payments collected" />
                     </children>
                  </VBox>

                  <!-- Card 5: Active Products -->
                  <VBox styleClass="kpi-card, card-blue" GridPane.columnIndex="0" GridPane.rowIndex="1">
                     <children>
                        <Label styleClass="kpi-title" text="ACTIVE PRODUCTS" />
                        <Label fx:id="activeProductsLabel" styleClass="kpi-value" text="0" />
                        <Label styleClass="kpi-subtext" text="Catalog dairy items" />
                     </children>
                  </VBox>

                  <!-- Card 6: System Health -->
                  <VBox styleClass="kpi-card, card-green" GridPane.columnIndex="1" GridPane.rowIndex="1">
                     <children>
                        <Label styleClass="kpi-title" text="SYSTEM STATUS" />
                        <Label fx:id="systemHealthLabel" styleClass="kpi-value" text="Operational" />
                        <Label styleClass="kpi-subtext" text="All subsystems healthy" />
                     </children>
                  </VBox>

                  <!-- Card 7: Delivery Zone -->
                  <VBox styleClass="kpi-card, card-purple" GridPane.columnIndex="2" GridPane.rowIndex="1">
                     <children>
                        <Label styleClass="kpi-title" text="PRIMARY COVERAGE" />
                        <Label styleClass="kpi-value" text="Nagpur Hub" />
                        <Label styleClass="kpi-subtext" text="10 Active delivery zones" />
                     </children>
                  </VBox>

                  <!-- Card 8: Database Engine -->
                  <VBox styleClass="kpi-card, card-orange" GridPane.columnIndex="3" GridPane.rowIndex="1">
                     <children>
                        <Label styleClass="kpi-title" text="DATABASE ENGINE" />
                        <Label styleClass="kpi-value" text="MySQL 8.0" />
                        <Label styleClass="kpi-subtext" text="HikariCP Pool Active" />
                     </children>
                  </VBox>
               </children>
            </GridPane>

            <!-- Recent System Accounts Section -->
            <VBox spacing="10.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.04), 8, 0, 0, 2);">
               <children>
                  <HBox alignment="CENTER_LEFT">
                     <children>
                        <VBox>
                           <children>
                              <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" text="Registered Platform Accounts" />
                              <Label style="-fx-text-fill: #64748B; -fx-font-size: 12px;" text="All administrator, vendor, and customer user profiles." />
                           </children>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                     </children>
                  </HBox>
                  <TableView fx:id="recentUsersTable" prefHeight="280.0">
                     <columns>
                        <TableColumn fx:id="colUserId" prefWidth="70.0" text="User ID" />
                        <TableColumn fx:id="colUsername" prefWidth="150.0" text="Username" />
                        <TableColumn fx:id="colFullName" prefWidth="220.0" text="Full Name" />
                        <TableColumn fx:id="colRole" prefWidth="120.0" text="Role" />
                        <TableColumn fx:id="colContact" prefWidth="240.0" text="Contact Info" />
                        <TableColumn fx:id="colStatus" prefWidth="120.0" text="Status" />
                     </columns>
                     <placeholder>
                        <Label text="No registered user accounts found in database." />
                     </placeholder>
                  </TableView>
               </children>
            </VBox>
         </children>
      </VBox>
   </content>
</ScrollPane>
