<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.agrodairy.management.controller.HolidayRequestsController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="15.0" />
   </padding>
   <children>
      <!-- Action Bar -->
      <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-background-color: #FFFFFF; -fx-padding: 12; -fx-background-radius: 8;">
         <children>
            <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" text="Customer Delivery Pause &amp; Holiday Requests" />
            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#refreshTable" styleClass="btn-secondary" text="🔄 Refresh" />
            <Button onAction="#handleApproveHoliday" styleClass="btn-success" text="✅ Approve Pause Request" />
            <Button onAction="#handleRejectHoliday" styleClass="btn-danger" text="❌ Reject Request" />
         </children>
      </HBox>

      <!-- Table -->
      <VBox style="-fx-background-color: #FFFFFF; -fx-padding: 15; -fx-background-radius: 8;" VBox.vgrow="ALWAYS">
         <children>
            <TableView fx:id="holidayTable" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colReqId" prefWidth="90.0" text="Request ID" />
                  <TableColumn fx:id="colCustName" prefWidth="180.0" text="Customer Name" />
                  <TableColumn fx:id="colStartDate" prefWidth="120.0" text="Start Date" />
                  <TableColumn fx:id="colEndDate" prefWidth="120.0" text="End Date" />
                  <TableColumn fx:id="colReason" prefWidth="200.0" text="Reason / Remarks" />
                  <TableColumn fx:id="colStatus" prefWidth="120.0" text="Approval Status" />
               </columns>
            </TableView>
         </children>
      </VBox>
   </children>
</VBox>
