<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.agrodairy.management.controller.DailyDeliveriesController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="15.0" />
   </padding>
   <children>
      <!-- Controls Top Bar -->
      <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #FFFFFF; -fx-padding: 12; -fx-background-radius: 8;">
         <children>
            <Label style="-fx-font-weight: bold;" text="Delivery Date:" />
            <DatePicker fx:id="deliveryDatePicker" prefWidth="150.0" />
            
            <Label style="-fx-font-weight: bold;" text="Shift:" />
            <ComboBox fx:id="shiftComboBox" prefWidth="130.0" />
            
            <Button onAction="#loadShiftDeliveries" styleClass="btn-primary" text="🔄 Load Deliveries" />
            <Region HBox.hgrow="ALWAYS" />
            
            <Button onAction="#handleMarkDelivered" styleClass="btn-success" text="✅ Mark Delivered" />
            <Button onAction="#handleMarkNotDelivered" styleClass="btn-danger" text="❌ Mark Not Delivered" />
            <Button onAction="#handleMarkPaused" styleClass="btn-warning" text="⏸️ Mark Paused" />
         </children>
      </HBox>

      <!-- Table of Deliveries -->
      <VBox style="-fx-background-color: #FFFFFF; -fx-padding: 15; -fx-background-radius: 8;" VBox.vgrow="ALWAYS">
         <children>
            <TableView fx:id="deliveriesTable" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colCustCode" prefWidth="100.0" text="Customer Code" />
                  <TableColumn fx:id="colCustName" prefWidth="180.0" text="Customer Name" />
                  <TableColumn fx:id="colArea" prefWidth="140.0" text="Delivery Area" />
                  <TableColumn fx:id="colMilkType" prefWidth="100.0" text="Milk Type" />
                  <TableColumn fx:id="colQty" prefWidth="110.0" text="Scheduled (L)" />
                  <TableColumn fx:id="colRate" prefWidth="120.0" text="Snapshot Rate" />
                  <TableColumn fx:id="colTotal" prefWidth="120.0" text="Total Amount (₹)" />
                  <TableColumn fx:id="colStatus" prefWidth="130.0" text="Status" />
                  <TableColumn fx:id="colRemarks" prefWidth="150.0" text="Remarks" />
               </columns>
            </TableView>
         </children>
      </VBox>
   </children>
</VBox>
