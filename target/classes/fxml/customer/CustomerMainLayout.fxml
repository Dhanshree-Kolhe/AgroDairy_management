<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="mainBorderPane" prefHeight="720.0" prefWidth="1100.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.agrodairy.management.controller.CustomerMainLayoutController">
   <left>
      <VBox prefWidth="240.0" styleClass="sidebar" BorderPane.alignment="CENTER">
         <children>
            <VBox spacing="4.0">
               <children>
                  <Label styleClass="sidebar-title" text="🥛 Smart Dairy" />
                  <Label style="-fx-text-fill: #64748B; -fx-font-size: 11px;" text="CUSTOMER MILK PORTAL" />
               </children>
               <padding>
                  <Insets bottom="15.0" left="10.0" right="10.0" top="5.0" />
               </padding>
            </VBox>
            
            <Separator style="-fx-background-color: #334155;" />
            
            <VBox spacing="4.0" VBox.vgrow="ALWAYS">
               <children>
                  <Button fx:id="navDashboardBtn" maxWidth="1.7976931348623157E308" onAction="#handleNavDashboard" styleClass="sidebar-nav-btn" text="📊 My Dashboard" />
                  <Button fx:id="navDeliveriesBtn" maxWidth="1.7976931348623157E308" onAction="#handleNavDeliveries" styleClass="sidebar-nav-btn" text="🚚 Delivery Status History" />
                  <Button fx:id="navBillsBtn" maxWidth="1.7976931348623157E308" onAction="#handleNavBills" styleClass="sidebar-nav-btn" text="💳 Monthly Bills &amp; Payment" />
                  <Button fx:id="navHolidayBtn" maxWidth="1.7976931348623157E308" onAction="#handleNavHoliday" styleClass="sidebar-nav-btn" text="🌴 Request Delivery Pause" />
                  <Button fx:id="navExtraOrdersBtn" maxWidth="1.7976931348623157E308" onAction="#handleNavExtraOrders" styleClass="sidebar-nav-btn" text="🛒 Order Extra Dairy Products" />
                  <Button fx:id="navKnowledgeBtn" maxWidth="1.7976931348623157E308" onAction="#handleNavKnowledge" styleClass="sidebar-nav-btn" text="📚 Dairy Knowledge Assistant" />
               </children>
               <padding>
                  <Insets top="10.0" />
               </padding>
            </VBox>
            
            <VBox spacing="10.0">
               <children>
                  <Separator style="-fx-background-color: #334155;" />
                  <Button maxWidth="1.7976931348623157E308" onAction="#handleLogout" styleClass="btn-danger" text="🚪 LOG OUT" />
               </children>
            </VBox>
         </children>
      </VBox>
   </left>
   
   <top>
      <HBox alignment="CENTER_LEFT" styleClass="top-bar" BorderPane.alignment="CENTER">
         <children>
            <Label fx:id="pageTitleLabel" styleClass="top-bar-title" text="Customer Dashboard" />
            <Region HBox.hgrow="ALWAYS" />
            <HBox alignment="CENTER" spacing="10.0">
               <children>
                  <Label fx:id="userWelcomeLabel" style="-fx-font-weight: bold; -fx-text-fill: #1E293B;" text="Welcome, Rahul Verma" />
                  <Label style="-fx-background-color: #D1FAE5; -fx-text-fill: #065F46; -fx-padding: 3 8; -fx-background-radius: 12; -fx-font-size: 11px; -fx-font-weight: bold;" text="CUSTOMER" />
               </children>
            </HBox>
         </children>
      </HBox>
   </top>
</BorderPane>
