<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" prefWidth="640.0" prefHeight="720.0" style="-fx-background-color: transparent; -fx-background: #FFFFFF;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.agrodairy.management.controller.CustomerPaymentDialogController">
   <content>
      <VBox spacing="14.0" style="-fx-background-color: #FFFFFF;">
         <padding>
            <Insets bottom="24.0" left="24.0" right="24.0" top="20.0" />
         </padding>
         <children>
            <!-- Header -->
            <VBox spacing="3.0">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <Label style="-fx-font-size: 19px; -fx-font-weight: bold; -fx-text-fill: #0F172A;" text="💳 Settle Monthly Milk Bill" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="gatewayStatusBadge" styleClass="badge-demo" text="⚡ DEMO SANDBOX &amp; OFFLINE" />
                     </children>
                  </HBox>
                  <Label style="-fx-text-fill: #64748B; -fx-font-size: 12.5px;" text="Review invoice details, select an online or offline payment method, and complete settlement." />
               </children>
            </VBox>

            <!-- Bill Overview Card -->
            <VBox spacing="10.0" styleClass="bill-summary-card">
               <children>
                  <HBox alignment="CENTER_LEFT">
                     <children>
                        <Label style="-fx-font-size: 12.5px; -fx-font-weight: bold; -fx-text-fill: #334155;" text="BILL SUMMARY DETAILS" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="customerNameLabel" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #2563EB;" text="Customer Name" />
                     </children>
                  </HBox>
                  
                  <GridPane hgap="12.0" vgap="6.0">
                     <columnConstraints>
                        <ColumnConstraints minWidth="120.0" prefWidth="130.0" />
                        <ColumnConstraints hgrow="ALWAYS" />
                        <ColumnConstraints minWidth="110.0" prefWidth="120.0" />
                        <ColumnConstraints hgrow="ALWAYS" />
                     </columnConstraints>
                     <rowConstraints>
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                     </rowConstraints>
                     <children>
                        <Label style="-fx-text-fill: #64748B; -fx-font-size: 12px;" text="Bill Number:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <Label fx:id="billNumberLabel" style="-fx-font-weight: bold; -fx-text-fill: #0F172A;" text="BILL-XXXXXX" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                        
                        <Label style="-fx-text-fill: #64748B; -fx-font-size: 12px;" text="Billing Period:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                        <Label fx:id="periodLabel" style="-fx-font-weight: bold; -fx-text-fill: #0F172A;" text="MM/YYYY" GridPane.columnIndex="3" GridPane.rowIndex="0" />
                        
                        <Label style="-fx-text-fill: #64748B; -fx-font-size: 12px;" text="Total Net Amount:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                        <Label fx:id="totalAmountLabel" style="-fx-font-weight: bold; -fx-text-fill: #0F172A;" text="₹0.00" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        
                        <Label style="-fx-text-fill: #64748B; -fx-font-size: 12px;" text="Paid So Far:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                        <Label fx:id="paidAmountLabel" style="-fx-font-weight: bold; -fx-text-fill: #059669;" text="₹0.00" GridPane.columnIndex="3" GridPane.rowIndex="1" />

                        <Separator GridPane.columnSpan="4" GridPane.rowIndex="2" />
                     </children>
                  </GridPane>

                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <Label style="-fx-font-size: 13.5px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" text="Remaining Balance Due:" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="balanceDueLabel" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #DC2626;" text="₹0.00" />
                     </children>
                  </HBox>
               </children>
            </VBox>

            <!-- Error Label (Global) -->
            <Label fx:id="errorLabel" managed="false" style="-fx-text-fill: #DC2626; -fx-font-size: 12px; -fx-font-weight: bold;" text="Validation error goes here" visible="false" />

            <!-- STEP 1: PAYMENT METHOD SELECTION FORM -->
            <VBox fx:id="formContainer" spacing="14.0">
               <children>
                  <!-- Payment Amount Section (Flexible Partial & Full) -->
                  <VBox spacing="6.0">
                     <children>
                        <HBox alignment="CENTER_LEFT">
                           <children>
                              <Label style="-fx-font-weight: bold; -fx-text-fill: #1E293B; -fx-font-size: 13px;" text="PAYMENT AMOUNT (₹):" />
                              <Region HBox.hgrow="ALWAYS" />
                              <HBox spacing="6.0">
                                 <children>
                                    <Button onAction="#handleFillFullAmount" styleClass="btn-chip" text="Pay Full Due" />
                                    <Button onAction="#handleFillHalfAmount" styleClass="btn-chip" text="Pay 50%" />
                                 </children>
                              </HBox>
                           </children>
                        </HBox>
                        <TextField fx:id="amountField" prefHeight="38.0" promptText="Enter payment amount in ₹ (e.g. 1000.00)" />
                     </children>
                  </VBox>

                  <!-- 1. CHOOSE PAYMENT METHOD -->
                  <VBox spacing="10.0">
                     <children>
                        <!-- Category A: Online Payment -->
                        <VBox spacing="6.0">
                           <children>
                              <HBox alignment="CENTER_LEFT" spacing="6.0">
                                 <children>
                                    <Label style="-fx-font-weight: bold; -fx-text-fill: #1E293B; -fx-font-size: 12.5px;" text="A. ONLINE PAYMENT" />
                                    <Label style="-fx-font-size: 10.5px; -fx-text-fill: #D97706; -fx-font-weight: bold;" text="(Demo Simulation / Gateway Not Configured)" />
                                 </children>
                              </HBox>
                              <GridPane hgap="10.0">
                                 <columnConstraints>
                                    <ColumnConstraints hgrow="ALWAYS" percentWidth="33.33" />
                                    <ColumnConstraints hgrow="ALWAYS" percentWidth="33.33" />
                                    <ColumnConstraints hgrow="ALWAYS" percentWidth="33.34" />
                                 </columnConstraints>
                                 <rowConstraints>
                                    <RowConstraints />
                                 </rowConstraints>
                                 <children>
                                    <!-- Option 1: UPI Demo -->
                                    <VBox fx:id="upiCardBox" alignment="CENTER" onMouseClicked="#handleSelectUpi" spacing="5.0" styleClass="payment-tab-card" GridPane.columnIndex="0">
                                       <children>
                                          <Label style="-fx-font-size: 20px;" text="📱" />
                                          <RadioButton fx:id="upiRadio" mnemonicParsing="false" style="-fx-font-weight: bold; -fx-font-size: 11.5px; -fx-text-fill: #0F172A;" text="UPI">
                                             <toggleGroup>
                                                <ToggleGroup fx:id="paymentMethodGroup" />
                                             </toggleGroup>
                                          </RadioButton>
                                          <Label style="-fx-font-size: 10px; -fx-text-fill: #64748B;" text="GPay, PhonePe, Paytm" />
                                       </children>
                                    </VBox>

                                    <!-- Option 2: Card Demo -->
                                    <VBox fx:id="cardCardBox" alignment="CENTER" onMouseClicked="#handleSelectCard" spacing="5.0" styleClass="payment-tab-card" GridPane.columnIndex="1">
                                       <children>
                                          <Label style="-fx-font-size: 20px;" text="💳" />
                                          <RadioButton fx:id="cardRadio" mnemonicParsing="false" style="-fx-font-weight: bold; -fx-font-size: 11.5px; -fx-text-fill: #0F172A;" text="Cards" toggleGroup="$paymentMethodGroup" />
                                          <Label style="-fx-font-size: 10px; -fx-text-fill: #64748B;" text="Debit / Credit Card" />
                                       </children>
                                    </VBox>

                                    <!-- Option 3: Net Banking Demo -->
                                    <VBox fx:id="netBankCardBox" alignment="CENTER" onMouseClicked="#handleSelectNetBank" spacing="5.0" styleClass="payment-tab-card" GridPane.columnIndex="2">
                                       <children>
                                          <Label style="-fx-font-size: 20px;" text="🏦" />
                                          <RadioButton fx:id="netBankRadio" mnemonicParsing="false" style="-fx-font-weight: bold; -fx-font-size: 11.5px; -fx-text-fill: #0F172A;" text="Net Banking" toggleGroup="$paymentMethodGroup" />
                                          <Label style="-fx-font-size: 10px; -fx-text-fill: #64748B;" text="SBI, HDFC, ICICI, Axis" />
                                       </children>
                                    </VBox>
                                 </children>
                              </GridPane>
                           </children>
                        </VBox>

                        <!-- Category B: Pay on Delivery / Offline Payment -->
                        <VBox spacing="6.0">
                           <children>
                              <HBox alignment="CENTER_LEFT" spacing="6.0">
                                 <children>
                                    <Label style="-fx-font-weight: bold; -fx-text-fill: #1E293B; -fx-font-size: 12.5px;" text="B. PAY ON DELIVERY / OFFLINE PAYMENT" />
                                    <Label style="-fx-font-size: 10.5px; -fx-text-fill: #059669; -fx-font-weight: bold;" text="(Direct Dairy Collection)" />
                                 </children>
                              </HBox>
                              <GridPane hgap="10.0">
                                 <columnConstraints>
                                    <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
                                    <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
                                 </columnConstraints>
                                 <rowConstraints>
                                    <RowConstraints />
                                 </rowConstraints>
                                 <children>
                                    <!-- Option 4: Cash / COD Handover -->
                                    <VBox fx:id="cashCardBox" alignment="CENTER" onMouseClicked="#handleSelectCash" spacing="5.0" styleClass="payment-tab-card" GridPane.columnIndex="0">
                                       <children>
                                          <Label style="-fx-font-size: 20px;" text="💵" />
                                          <RadioButton fx:id="cashRadio" mnemonicParsing="false" style="-fx-font-weight: bold; -fx-font-size: 11.5px; -fx-text-fill: #0F172A;" text="Cash on Delivery (COD)" toggleGroup="$paymentMethodGroup" />
                                          <Label style="-fx-font-size: 10px; -fx-text-fill: #64748B;" text="Doorstep handover to vendor" />
                                       </children>
                                    </VBox>

                                    <!-- Option 5: Bank Transfer (Pending Verification) -->
                                    <VBox fx:id="bankTransferCardBox" alignment="CENTER" onMouseClicked="#handleSelectBankTransfer" spacing="5.0" styleClass="payment-tab-card" GridPane.columnIndex="1">
                                       <children>
                                          <Label style="-fx-font-size: 20px;" text="🏛️" />
                                          <RadioButton fx:id="bankTransferRadio" mnemonicParsing="false" style="-fx-font-weight: bold; -fx-font-size: 11.5px; -fx-text-fill: #0F172A;" text="Bank Transfer (NEFT/IMPS)" toggleGroup="$paymentMethodGroup" />
                                          <Label style="-fx-font-size: 10px; -fx-text-fill: #64748B;" text="Requires UTR / Pending approval" />
                                       </children>
                                    </VBox>
                                 </children>
                              </GridPane>
                           </children>
                        </VBox>
                     </children>
                  </VBox>

                  <!-- 2. PAYMENT METHOD DETAILS SUB-PANELS -->
                  <StackPane>
                     <children>
                        <!-- SUB-PANEL 1: UPI DEMO -->
                        <VBox fx:id="upiPanel" spacing="12.0" style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 14;">
                           <children>
                              <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="demo-notice-box">
                                 <children>
                                    <Label style="-fx-font-size: 15px;" text="⚡" />
                                    <Label style="-fx-font-size: 11.5px; -fx-text-fill: #92400E; -fx-wrap-text: true;" text="Online Gateway Unconfigured (Demo Sandbox): Select a simulated UPI app or enter any demo UPI ID. Confirms simulation without deducting real money." HBox.hgrow="ALWAYS" />
                                 </children>
                              </HBox>

                              <VBox spacing="6.0">
                                 <children>
                                    <Label style="-fx-font-weight: bold; -fx-text-fill: #334155; -fx-font-size: 12px;" text="Select Simulated UPI App:" />
                                    <HBox spacing="8.0">
                                       <children>
                                          <Button onAction="#handleSelectGpayApp" styleClass="btn-chip" text="Google Pay (GPay)" />
                                          <Button onAction="#handleSelectPhonePeApp" styleClass="btn-chip" text="PhonePe" />
                                          <Button onAction="#handleSelectPaytmApp" styleClass="btn-chip" text="Paytm" />
                                          <Button onAction="#handleSelectBhimApp" styleClass="btn-chip" text="BHIM UPI" />
                                       </children>
                                    </HBox>
                                 </children>
                              </VBox>

                              <VBox spacing="4.0">
                                 <children>
                                    <Label style="-fx-font-weight: bold; -fx-text-fill: #334155; -fx-font-size: 12px;" text="Virtual Payment Address (UPI ID):" />
                                    <TextField fx:id="upiIdField" prefHeight="36.0" promptText="e.g. yourname@okhdfcbank" text="cust.rahul@okhdfcbank" />
                                    <Label style="-fx-text-fill: #64748B; -fx-font-size: 11px;" text="Demo input. No PIN verification or real banking connection is required." />
                                 </children>
                              </VBox>
                           </children>
                        </VBox>

                        <!-- SUB-PANEL 2: CARD DEMO -->
                        <VBox fx:id="cardPanel" managed="false" spacing="12.0" style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 14;" visible="false">
                           <children>
                              <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="demo-notice-box">
                                 <children>
                                    <Label style="-fx-font-size: 15px;" text="🔒" />
                                    <Label style="-fx-font-size: 11.5px; -fx-text-fill: #92400E; -fx-wrap-text: true;" text="Debit/Credit Card Demo: Safe sandbox inputs. Do not enter real banking or credit card details." HBox.hgrow="ALWAYS" />
                                 </children>
                              </HBox>

                              <VBox spacing="4.0">
                                 <children>
                                    <Label style="-fx-font-weight: bold; -fx-text-fill: #334155; -fx-font-size: 12px;" text="Card Number (Demo):" />
                                    <TextField fx:id="cardNumberField" prefHeight="36.0" promptText="4242 4242 4242 4242" text="4242 •••• •••• 4242" />
                                 </children>
                              </VBox>

                              <HBox spacing="10.0">
                                 <children>
                                    <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                       <children>
                                          <Label style="-fx-font-weight: bold; -fx-text-fill: #334155; -fx-font-size: 12px;" text="Cardholder Name:" />
                                          <TextField fx:id="cardNameField" prefHeight="36.0" promptText="e.g. Rahul Verma" text="Rahul Verma" />
                                       </children>
                                    </VBox>
                                    <VBox prefWidth="90.0" spacing="4.0">
                                       <children>
                                          <Label style="-fx-font-weight: bold; -fx-text-fill: #334155; -fx-font-size: 12px;" text="Expiry:" />
                                          <TextField fx:id="cardExpiryField" prefHeight="36.0" promptText="MM/YY" text="12/28" />
                                       </children>
                                    </VBox>
                                    <VBox prefWidth="80.0" spacing="4.0">
                                       <children>
                                          <Label style="-fx-font-weight: bold; -fx-text-fill: #334155; -fx-font-size: 12px;" text="CVV:" />
                                          <TextField fx:id="cardCvvField" prefHeight="36.0" promptText="•••" text="123" />
                                       </children>
                                    </VBox>
                                 </children>
                              </HBox>
                           </children>
                        </VBox>

                        <!-- SUB-PANEL 3: NET BANKING DEMO -->
                        <VBox fx:id="netBankPanel" managed="false" spacing="12.0" style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 14;" visible="false">
                           <children>
                              <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="demo-notice-box">
                                 <children>
                                    <Label style="-fx-font-size: 15px;" text="🏦" />
                                    <Label style="-fx-font-size: 11.5px; -fx-text-fill: #92400E; -fx-wrap-text: true;" text="Net Banking Demo: Select any supported Indian bank for simulated payment settlement." HBox.hgrow="ALWAYS" />
                                 </children>
                              </HBox>

                              <VBox spacing="6.0">
                                 <children>
                                    <Label style="-fx-font-weight: bold; -fx-text-fill: #334155; -fx-font-size: 12px;" text="Select Bank:" />
                                    <ComboBox fx:id="bankSelectorCombo" prefHeight="36.0" prefWidth="380.0" />
                                 </children>
                              </VBox>

                              <HBox spacing="8.0">
                                 <children>
                                    <Button onAction="#handleSelectHdfc" styleClass="btn-chip" text="HDFC Bank" />
                                    <Button onAction="#handleSelectSbi" styleClass="btn-chip" text="State Bank of India" />
                                    <Button onAction="#handleSelectIcici" styleClass="btn-chip" text="ICICI Bank" />
                                    <Button onAction="#handleSelectAxis" styleClass="btn-chip" text="Axis Bank" />
                                 </children>
                              </HBox>
                           </children>
                        </VBox>

                        <!-- SUB-PANEL 4: CASH ON DELIVERY / DOORSTEP HANDOVER -->
                        <VBox fx:id="cashPanel" managed="false" spacing="12.0" style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 14;" visible="false">
                           <children>
                              <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: #ECFDF5; -fx-border-color: #A7F3D0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 14; -fx-border-width: 1;">
                                 <children>
                                    <Label style="-fx-font-size: 15px;" text="💵" />
                                    <Label style="-fx-font-size: 11.5px; -fx-text-fill: #065F46; -fx-wrap-text: true;" text="Cash on Delivery / Direct Vendor Payment: Hand over cash directly to your milk delivery agent during daily rounds." HBox.hgrow="ALWAYS" />
                                 </children>
                              </HBox>

                              <VBox spacing="6.0" style="-fx-padding: 4 6;">
                                 <children>
                                    <Label style="-fx-font-weight: bold; -fx-text-fill: #1E293B; -fx-font-size: 12.5px;" text="Doorstep Cash Instructions:" />
                                    <Label style="-fx-text-fill: #475569; -fx-font-size: 11.5px;" text="1. Hand over the exact cash amount to your delivery rider during morning or evening milk drop." />
                                    <Label style="-fx-text-fill: #475569; -fx-font-size: 11.5px;" text="2. A pending cash collection request will be recorded in the dairy management ledger." />
                                    <Label style="-fx-text-fill: #475569; -fx-font-size: 11.5px;" text="3. Payment will be marked as officially successful after vendor/agent collection is confirmed." />
                                 </children>
                              </VBox>
                           </children>
                        </VBox>

                        <!-- SUB-PANEL 5: BANK TRANSFER (PENDING VERIFICATION) -->
                        <VBox fx:id="bankTransferPanel" managed="false" spacing="12.0" style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 14;" visible="false">
                           <children>
                              <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: #EFF6FF; -fx-border-color: #BFDBFE; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 14; -fx-border-width: 1;">
                                 <children>
                                    <Label style="-fx-font-size: 15px;" text="🏛️" />
                                    <Label style="-fx-font-size: 11.5px; -fx-text-fill: #1E40AF; -fx-wrap-text: true;" text="Direct Bank Transfer: Transfer via NEFT / RTGS / IMPS. Payment remains PENDING VERIFICATION until approved by vendor/admin." HBox.hgrow="ALWAYS" />
                                 </children>
                              </HBox>

                              <!-- Dairy Official Beneficiary Box -->
                              <VBox spacing="4.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #CBD5E1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 10;">
                                 <children>
                                    <Label style="-fx-font-weight: bold; -fx-text-fill: #1E293B; -fx-font-size: 12px;" text="Official Dairy Bank Account Details:" />
                                    <Label style="-fx-text-fill: #475569; -fx-font-size: 11.5px;" text="• Beneficiary: AgroDairy Management Pvt. Ltd." />
                                    <Label style="-fx-text-fill: #475569; -fx-font-size: 11.5px;" text="• Account Number: 924020054817290" />
                                    <Label style="-fx-text-fill: #475569; -fx-font-size: 11.5px;" text="• IFSC Code: ICIC0000102 (ICICI Bank, Dharampeth, Nagpur)" />
                                 </children>
                              </VBox>

                              <VBox spacing="4.0">
                                 <children>
                                    <Label style="-fx-font-weight: bold; -fx-text-fill: #334155; -fx-font-size: 12px;" text="Bank Transaction Reference / UTR Number (Required):" />
                                    <TextField fx:id="bankUtrField" prefHeight="36.0" promptText="e.g. UTR123456789 or IMPS987654" />
                                    <Label style="-fx-text-fill: #64748B; -fx-font-size: 11px;" text="Please enter your genuine bank UTR so admin/vendor can verify and credit your balance." />
                                 </children>
                              </VBox>
                           </children>
                        </VBox>
                     </children>
                  </StackPane>

                  <!-- 3. SELECTED METHOD SUMMARY BAR -->
                  <VBox spacing="4.0" style="-fx-background-color: #F1F5F9; -fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 14;">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                           <children>
                              <Label style="-fx-font-weight: bold; -fx-text-fill: #475569; -fx-font-size: 11.5px;" text="Selected Method:" />
                              <Label fx:id="selectedMethodDisplayLabel" style="-fx-font-weight: bold; -fx-text-fill: #0F172A; -fx-font-size: 12px;" text="📱 UPI (Demo) — Google Pay (GPay)" />
                           </children>
                        </HBox>
                        <Label fx:id="outcomeExplanationLabel" style="-fx-text-fill: #64748B; -fx-font-size: 11px;" text="Simulates transaction and updates ledger &amp; bill balance directly in MySQL." />
                     </children>
                  </VBox>

                  <!-- Step 1 Actions -->
                  <HBox alignment="CENTER_RIGHT" spacing="12.0">
                     <children>
                        <Button onAction="#handleCancel" prefHeight="38.0" prefWidth="100.0" styleClass="btn-secondary" text="Cancel" />
                        <Button fx:id="proceedToConfirmBtn" onAction="#handleProceedToConfirmation" prefHeight="38.0" styleClass="btn-primary" text="Proceed to Confirmation →" />
                     </children>
                     <padding>
                        <Insets top="6.0" />
                     </padding>
                  </HBox>
               </children>
            </VBox>

            <!-- STEP 2: CONFIRMATION & REVIEW SCREEN -->
            <VBox fx:id="confirmationContainer" managed="false" spacing="14.0" visible="false">
               <children>
                  <VBox spacing="12.0" styleClass="bill-summary-card" style="-fx-border-color: #2563EB; -fx-border-width: 1.5;">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                           <children>
                              <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" text="📋 Confirm Payment Details" />
                              <Region HBox.hgrow="ALWAYS" />
                              <Label fx:id="confirmStatusBadge" styleClass="badge-demo" text="REVIEW REQUIRED" />
                           </children>
                        </HBox>
                        
                        <Separator />

                        <GridPane hgap="12.0" vgap="8.0">
                           <columnConstraints>
                              <ColumnConstraints minWidth="130.0" prefWidth="150.0" />
                              <ColumnConstraints hgrow="ALWAYS" />
                           </columnConstraints>
                           <rowConstraints>
                              <RowConstraints />
                              <RowConstraints />
                              <RowConstraints />
                              <RowConstraints />
                              <RowConstraints />
                           </rowConstraints>
                           <children>
                              <Label style="-fx-text-fill: #64748B; -fx-font-size: 12px;" text="Customer:" GridPane.rowIndex="0" />
                              <Label fx:id="confirmCustomerLabel" style="-fx-font-weight: bold; -fx-text-fill: #0F172A;" text="-" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                              <Label style="-fx-text-fill: #64748B; -fx-font-size: 12px;" text="Bill Statement:" GridPane.rowIndex="1" />
                              <Label fx:id="confirmBillNumberLabel" style="-fx-font-weight: bold; -fx-text-fill: #0F172A;" text="-" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                              <Label style="-fx-text-fill: #64748B; -fx-font-size: 12px;" text="Selected Method:" GridPane.rowIndex="2" />
                              <Label fx:id="confirmMethodLabel" style="-fx-font-weight: bold; -fx-text-fill: #2563EB;" text="-" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                              <Label style="-fx-text-fill: #64748B; -fx-font-size: 12px;" text="Processing Nature:" GridPane.rowIndex="3" />
                              <Label fx:id="confirmNatureLabel" style="-fx-text-fill: #334155; -fx-font-size: 11.5px; -fx-wrap-text: true;" text="-" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                              <Label style="-fx-text-fill: #1E293B; -fx-font-size: 14px; -fx-font-weight: bold;" text="Payment Amount:" GridPane.rowIndex="4" />
                              <Label fx:id="confirmAmountLabel" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #059669;" text="₹0.00" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                           </children>
                        </GridPane>
                     </children>
                  </VBox>

                  <!-- Step 2 Actions -->
                  <HBox alignment="CENTER_RIGHT" spacing="12.0">
                     <children>
                        <Button onAction="#handleBackToForm" prefHeight="38.0" styleClass="btn-secondary" text="← Back &amp; Edit" />
                        <Button onAction="#handleCancel" prefHeight="38.0" prefWidth="90.0" styleClass="btn-secondary" text="Cancel" />
                        <Button fx:id="confirmPaymentBtn" onAction="#handleConfirmPayment" prefHeight="38.0" styleClass="btn-success" text="✅ Confirm Payment" />
                     </children>
                     <padding>
                        <Insets top="6.0" />
                     </padding>
                  </HBox>
               </children>
            </VBox>
         </children>
      </VBox>
   </content>
</ScrollPane>
