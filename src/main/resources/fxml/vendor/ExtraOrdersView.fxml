<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.agrodairy.management.controller.ExtraOrdersController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="15.0" />
   </padding>
   <children>
      <!-- Action Bar -->
      <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-background-color: #FFFFFF; -fx-padding: 12; -fx-background-radius: 8;">
         <children>
            <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" text="Customer Extra Product Orders (Paneer, Curd, Ghee, Butter)" />
            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#refreshTable" styleClass="btn-secondary" text="🔄 Refresh" />
            <Button onAction="#handleApproveOrder" styleClass="btn-success" text="✅ Approve Order &amp; Deduct Stock" />
            <Button onAction="#handleRejectOrder" styleClass="btn-danger" text="❌ Reject Order" />
         </children>
      </HBox>

      <!-- Table -->
      <VBox style="-fx-background-color: #FFFFFF; -fx-padding: 15; -fx-background-radius: 8;" VBox.vgrow="ALWAYS">
         <children>
            <TableView fx:id="ordersTable" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colOrderId" prefWidth="80.0" text="Order ID" />
                  <TableColumn fx:id="colCustName" prefWidth="160.0" text="Customer Name" />
                  <TableColumn fx:id="colProdName" prefWidth="150.0" text="Product" />
                  <TableColumn fx:id="colQty" prefWidth="100.0" text="Quantity" />
                  <TableColumn fx:id="colSnapshotPrice" prefWidth="120.0" text="Snapshot Price" />
                  <TableColumn fx:id="colTotalPrice" prefWidth="120.0" text="Total Price (₹)" />
                  <TableColumn fx:id="colDeliveryDate" prefWidth="120.0" text="Delivery Date" />
                  <TableColumn fx:id="colStatus" prefWidth="120.0" text="Status" />
               </columns>
            </TableView>
         </children>
      </VBox>
   </children>
</VBox>
