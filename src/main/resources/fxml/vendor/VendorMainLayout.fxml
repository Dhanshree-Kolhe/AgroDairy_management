<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="mainBorderPane" prefHeight="720.0" prefWidth="1100.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.agrodairy.management.controller.VendorMainLayoutController">
   <left>
      <VBox prefWidth="240.0" styleClass="sidebar" BorderPane.alignment="CENTER">
         <children>
            <VBox spacing="4.0">
               <children>
                  <Label styleClass="sidebar-title" text="🥛 AgroDairy" />
                  <Label style="-fx-text-fill: #64748B; -fx-font-size: 11px;" text="VENDOR CONTROL PORTAL" />
               </children>
               <padding>
                  <Insets bottom="15.0" left="10.0" right="10.0" top="5.0" />
               </padding>
            </VBox>
            
            <Separator style="-fx-background-color: #334155;" />
            
            <VBox spacing="4.0" VBox.vgrow="ALWAYS">
               <children>
                  <Button fx:id="navDashboardBtn" maxWidth="1.7976931348623157E308" onAction="#handleNavDashboard" styleClass="sidebar-nav-btn" text="📊 Vendor Dashboard" />
                  <Button fx:id="navCustomersBtn" maxWidth="1.7976931348623157E308" onAction="#handleNavCustomers" styleClass="sidebar-nav-btn" text="👥 Customer Management" />
                  <Button fx:id="navDeliveriesBtn" maxWidth="1.7976931348623157E308" onAction="#handleNavDeliveries" styleClass="sidebar-nav-btn" text="🚚 Daily Shift Deliveries" />
                  <Button fx:id="navBillingBtn" maxWidth="1.7976931348623157E308" onAction="#handleNavBilling" styleClass="sidebar-nav-btn" text="💳 Billing &amp; Payments" />
                  <Button fx:id="navInventoryBtn" maxWidth="1.7976931348623157E308" onAction="#handleNavInventory" styleClass="sidebar-nav-btn" text="📦 Inventory Stock" />
                  <Button fx:id="navExtraOrdersBtn" maxWidth="1.7976931348623157E308" onAction="#handleNavExtraOrders" styleClass="sidebar-nav-btn" text="🛒 Extra Product Orders" />
                  <Button fx:id="navHolidaysBtn" maxWidth="1.7976931348623157E308" onAction="#handleNavHolidays" styleClass="sidebar-nav-btn" text="🌴 Holiday Pause Requests" />
                  <Button fx:id="navRoutePlannerBtn" maxWidth="1.7976931348623157E308" onAction="#handleNavRoutePlanner" styleClass="sidebar-nav-btn" text="🗺️ Delivery Route Planner" />
                  <Button fx:id="navNotificationsBtn" maxWidth="1.7976931348623157E308" onAction="#handleNavNotifications" styleClass="sidebar-nav-btn" text="🔔 System Notifications" />
                  <Button fx:id="navKnowledgeBtn" maxWidth="1.7976931348623157E308" onAction="#handleNavKnowledge" styleClass="sidebar-nav-btn" text="📚 Dairy Knowledge Base" />
               </children>
               <padding>
                  <Insets top="10.0" />
               </padding>
            </VBox>
            
            <VBox spacing="10.0">
               <children>
                  <Separator style="-fx-background-color: #334155;" />
                  <Button maxWidth="1.7976931348623157E308" onAction="#handleLogout" styleClass="btn-danger" text="🚪 LOG OUT" />
               </children>
            </VBox>
         </children>
      </VBox>
   </left>
   
   <top>
      <HBox alignment="CENTER_LEFT" styleClass="top-bar" BorderPane.alignment="CENTER">
         <children>
            <Label fx:id="pageTitleLabel" styleClass="top-bar-title" text="Vendor Dashboard" />
            <Region HBox.hgrow="ALWAYS" />
            <HBox alignment="CENTER" spacing="10.0">
               <children>
                  <Label fx:id="userWelcomeLabel" style="-fx-font-weight: bold; -fx-text-fill: #1E293B;" text="Welcome, Vendor" />
                  <Label style="-fx-background-color: #DBEAFE; -fx-text-fill: #1E40AF; -fx-padding: 3 8; -fx-background-radius: 12; -fx-font-size: 11px; -fx-font-weight: bold;" text="VENDOR" />
               </children>
            </HBox>
         </children>
      </HBox>
   </top>
</BorderPane>
