<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.agrodairy.management.controller.NotificationsController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="15.0" />
   </padding>
   <children>
      <!-- Action Bar -->
      <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-background-color: #FFFFFF; -fx-padding: 12; -fx-background-radius: 8;">
         <children>
            <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" text="System Alerts &amp; Operations Notifications" />
            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#refreshTable" styleClass="btn-secondary" text="🔄 Refresh" />
            <Button onAction="#handleMarkAsRead" styleClass="btn-primary" text="✓ Mark Selected as Read" />
         </children>
      </HBox>

      <!-- Table -->
      <VBox style="-fx-background-color: #FFFFFF; -fx-padding: 15; -fx-background-radius: 8;" VBox.vgrow="ALWAYS">
         <children>
            <TableView fx:id="notificationsTable" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colCategory" prefWidth="130.0" text="Category" />
                  <TableColumn fx:id="colTitle" prefWidth="180.0" text="Title" />
                  <TableColumn fx:id="colMessage" prefWidth="350.0" text="Message Details" />
                  <TableColumn fx:id="colDate" prefWidth="140.0" text="Date / Time" />
                  <TableColumn fx:id="colStatus" prefWidth="100.0" text="Read Status" />
               </columns>
            </TableView>
         </children>
      </VBox>
   </children>
</VBox>
