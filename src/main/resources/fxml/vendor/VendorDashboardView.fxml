<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.agrodairy.management.controller.VendorDashboardController">
   <content>
      <VBox spacing="20.0">
         <padding>
            <Insets bottom="25.0" left="25.0" right="25.0" top="20.0" />
         </padding>
         <children>
            <!-- Header Banner -->
            <HBox alignment="CENTER_LEFT" spacing="15.0">
               <children>
                  <VBox spacing="3.0">
                     <children>
                        <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #0F172A;" text="Vendor Daily Dashboard Summary" />
                        <Label style="-fx-text-fill: #64748B; -fx-font-size: 13px;" text="Real-time operational metrics for Nagpur milk delivery zones" />
                     </children>
                  </VBox>
               </children>
            </HBox>
            
            <!-- 7 KPI Dashboard Cards Grid -->
            <GridPane hgap="15.0" vgap="15.0">
               <columnConstraints>
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
               </columnConstraints>
               <rowConstraints>
                  <RowConstraints minHeight="10.0" prefHeight="95.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="95.0" vgrow="SOMETIMES" />
               </rowConstraints>
               <children>
                  <!-- 1. Today's Customers -->
                  <VBox styleClass="kpi-card, card-blue" GridPane.columnIndex="0" GridPane.rowIndex="0">
                     <children>
                        <Label styleClass="kpi-title" text="TODAY'S CUSTOMERS" />
                        <Label fx:id="todaysCustomersLabel" styleClass="kpi-value" text="0" />
                        <Label styleClass="kpi-subtext" text="Active Subscriptions" />
                     </children>
                  </VBox>

                  <!-- 2. Delivered -->
                  <VBox styleClass="kpi-card, card-green" GridPane.columnIndex="1" GridPane.rowIndex="0">
                     <children>
                        <Label styleClass="kpi-title" text="DELIVERED TODAY" />
                        <Label fx:id="deliveredLabel" styleClass="kpi-value" text="0" />
                        <Label styleClass="kpi-subtext" text="Completed Shift Orders" />
                     </children>
                  </VBox>

                  <!-- 3. Pending Deliveries -->
                  <VBox styleClass="kpi-card, card-orange" GridPane.columnIndex="2" GridPane.rowIndex="0">
                     <children>
                        <Label styleClass="kpi-title" text="PENDING DELIVERIES" />
                        <Label fx:id="pendingDeliveriesLabel" styleClass="kpi-value" text="0" />
                        <Label styleClass="kpi-subtext" text="Awaiting Shift Action" />
                     </children>
                  </VBox>

                  <!-- 4. Today's Revenue -->
                  <VBox styleClass="kpi-card, card-purple" GridPane.columnIndex="3" GridPane.rowIndex="0">
                     <children>
                        <Label styleClass="kpi-title" text="TODAY'S REVENUE" />
                        <Label fx:id="todaysRevenueLabel" styleClass="kpi-value" text="₹0.00" />
                        <Label styleClass="kpi-subtext" text="Snapshot Milk Value" />
                     </children>
                  </VBox>

                  <!-- 5. Pending Payments -->
                  <VBox styleClass="kpi-card, card-red" GridPane.columnIndex="0" GridPane.rowIndex="1">
                     <children>
                        <Label styleClass="kpi-title" text="PENDING PAYMENTS" />
                        <Label fx:id="pendingPaymentsLabel" styleClass="kpi-value" text="0 Bills" />
                        <Label styleClass="kpi-subtext" text="Uncollected Monthly Dues" />
                     </children>
                  </VBox>

                  <!-- 6. Extra Orders -->
                  <VBox styleClass="kpi-card, card-blue" GridPane.columnIndex="1" GridPane.rowIndex="1">
                     <children>
                        <Label styleClass="kpi-title" text="EXTRA ORDERS" />
                        <Label fx:id="extraOrdersLabel" styleClass="kpi-value" text="0 Pending" />
                        <Label styleClass="kpi-subtext" text="Paneer, Ghee, Curd Requests" />
                     </children>
                  </VBox>

                  <!-- 7. Low Stock Alerts -->
                  <VBox styleClass="kpi-card, card-orange" GridPane.columnIndex="2" GridPane.rowIndex="1">
                     <children>
                        <Label styleClass="kpi-title" text="LOW STOCK ALERTS" />
                        <Label fx:id="lowStockAlertsLabel" styleClass="kpi-value" text="0 Items" />
                        <Label styleClass="kpi-subtext" text="Below Reorder Threshold" />
                     </children>
                  </VBox>

                  <VBox alignment="CENTER" spacing="8.0" styleClass="kpi-card" GridPane.columnIndex="3" GridPane.rowIndex="1">
                     <children>
                        <Label style="-fx-font-weight: bold; -fx-font-size: 12px;" text="QUICK ACTIONS" />
                        <HBox alignment="CENTER" spacing="8.0">
                           <children>
                              <Button onAction="#refreshDashboard" styleClass="btn-secondary" text="🔄 Refresh" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </children>
            </GridPane>

            <!-- Table of Today's Shift Deliveries -->
            <VBox spacing="10.0" style="-fx-background-color: #FFFFFF; -fx-padding: 18; -fx-background-radius: 10;">
               <children>
                  <HBox alignment="CENTER_LEFT">
                     <children>
                        <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Today's Shift Customers &amp; Delivery Progress" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label style="-fx-text-fill: #64748B; -fx-font-size: 12px;" text="Nagpur Area Coverage" />
                     </children>
                  </HBox>
                  <TableView fx:id="dashboardTable" prefHeight="260.0">
                     <columns>
                        <TableColumn fx:id="colCustCode" prefWidth="110.0" text="Customer Code" />
                        <TableColumn fx:id="colCustName" prefWidth="180.0" text="Customer Name" />
                        <TableColumn fx:id="colArea" prefWidth="140.0" text="Area / Zone" />
                        <TableColumn fx:id="colMilkType" prefWidth="100.0" text="Milk Type" />
                        <TableColumn fx:id="colShift" prefWidth="110.0" text="Shift" />
                        <TableColumn fx:id="colQuantity" prefWidth="110.0" text="Quantity (L)" />
                        <TableColumn fx:id="colRate" prefWidth="110.0" text="Rate (₹/L)" />
                        <TableColumn fx:id="colStatus" prefWidth="120.0" text="Status" />
                     </columns>
                  </TableView>
               </children>
            </VBox>
         </children>
      </VBox>
   </content>
</ScrollPane>
