<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.agrodairy.management.controller.InventoryController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="15.0" />
   </padding>
   <children>
      <!-- Top Action Bar -->
      <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-background-color: #FFFFFF; -fx-padding: 12; -fx-background-radius: 8;">
         <children>
            <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" text="Dairy Products Inventory Stock &amp; Reorder Levels" />
            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#refreshTable" styleClass="btn-secondary" text="🔄 Refresh" />
            <Button onAction="#handleAddStock" styleClass="btn-primary" text="📦 Add Restock Quantity" />
         </children>
      </HBox>

      <!-- Inventory Table -->
      <VBox style="-fx-background-color: #FFFFFF; -fx-padding: 15; -fx-background-radius: 8;" VBox.vgrow="ALWAYS">
         <children>
            <TableView fx:id="inventoryTable" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colProdCode" prefWidth="110.0" text="Product Code" />
                  <TableColumn fx:id="colProdName" prefWidth="180.0" text="Product Name" />
                  <TableColumn fx:id="colCategory" prefWidth="120.0" text="Category" />
                  <TableColumn fx:id="colUnit" prefWidth="90.0" text="Unit" />
                  <TableColumn fx:id="colPrice" prefWidth="110.0" text="Unit Price (₹)" />
                  <TableColumn fx:id="colCurrentStock" prefWidth="130.0" text="Current Stock" />
                  <TableColumn fx:id="colReorderLevel" prefWidth="130.0" text="Reorder Level" />
                  <TableColumn fx:id="colStockStatus" prefWidth="140.0" text="Stock Warning" />
               </columns>
            </TableView>
         </children>
      </VBox>
   </children>
</VBox>
