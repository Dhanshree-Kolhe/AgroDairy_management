<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="mainBorderPane" prefHeight="720.0" prefWidth="1100.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.agrodairy.management.controller.AdminMainLayoutController">
   <left>
      <VBox prefWidth="250.0" styleClass="sidebar" BorderPane.alignment="CENTER">
         <children>
            <VBox spacing="4.0">
               <children>
                  <Label styleClass="sidebar-title" text="🥛 AgroDairy" />
                  <Label style="-fx-text-fill: #94A3B8; -fx-font-size: 11px; -fx-font-weight: bold;" text="ADMINISTRATION CONSOLE" />
               </children>
               <padding>
                  <Insets bottom="15.0" left="10.0" right="10.0" top="5.0" />
               </padding>
            </VBox>
            
            <Separator style="-fx-background-color: #334155;" />
            
            <VBox spacing="6.0" VBox.vgrow="ALWAYS">
               <children>
                  <Button fx:id="navDashboardBtn" maxWidth="1.7976931348623157E308" onAction="#handleNavDashboard" styleClass="sidebar-nav-btn" text="📊 System Dashboard" />
                  <Button fx:id="navUsersBtn" maxWidth="1.7976931348623157E308" onAction="#handleNavUsers" styleClass="sidebar-nav-btn" text="👥 User Management" />
                  <Button fx:id="navProductsBtn" maxWidth="1.7976931348623157E308" onAction="#handleNavProducts" styleClass="sidebar-nav-btn" text="📦 Products Catalog" />
                  <Button fx:id="navSystemStatusBtn" maxWidth="1.7976931348623157E308" onAction="#handleNavSystemStatus" styleClass="sidebar-nav-btn" text="⚡ System Diagnostics" />
               </children>
               <padding>
                  <Insets top="10.0" />
               </padding>
            </VBox>
            
            <VBox spacing="10.0">
               <children>
                  <Separator style="-fx-background-color: #334155;" />
                  <Button maxWidth="1.7976931348623157E308" onAction="#handleLogout" styleClass="btn-danger" text="🚪 LOG OUT" />
               </children>
            </VBox>
         </children>
      </VBox>
   </left>
   
   <top>
      <HBox alignment="CENTER_LEFT" styleClass="top-bar" BorderPane.alignment="CENTER">
         <children>
            <Label fx:id="pageTitleLabel" styleClass="top-bar-title" text="Admin Console" />
            <Region HBox.hgrow="ALWAYS" />
            <HBox alignment="CENTER" spacing="12.0">
               <children>
                  <Label fx:id="userWelcomeLabel" style="-fx-font-weight: bold; -fx-text-fill: #1E293B;" text="Welcome, Administrator" />
                  <Label style="-fx-background-color: #EDE9FE; -fx-text-fill: #6D28D9; -fx-padding: 4 10; -fx-background-radius: 12; -fx-font-size: 11px; -fx-font-weight: bold;" text="ADMIN" />
               </children>
            </HBox>
         </children>
      </HBox>
   </top>
</BorderPane>
