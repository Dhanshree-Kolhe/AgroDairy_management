<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<VBox spacing="14.0" style="-fx-background-color: #F1F5F9;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.agrodairy.management.controller.KnowledgeAssistantController">
   <padding>
      <Insets bottom="16.0" left="20.0" right="20.0" top="16.0" />
   </padding>
   <children>
      <!-- Top Title and Status Header -->
      <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-background-color: #FFFFFF; -fx-padding: 14 18; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.04), 6, 0, 0, 2);">
         <children>
            <VBox spacing="2.0" HBox.hgrow="ALWAYS">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <Label style="-fx-font-size: 19px; -fx-font-weight: bold; -fx-text-fill: #0F172A;" text="🤖 AI Dairy Assistant &amp; Vision Inspection" />
                        <Label fx:id="aiStatusBadge" styleClass="badge-ai" text="🟢 AI Ready" />
                     </children>
                  </HBox>
                  <Label style="-fx-text-fill: #64748B; -fx-font-size: 12.5px;" text="Interactive AI chat and genuine vision inspection for cattle health concerns and milk quality assessments." />
               </children>
            </VBox>
            <Button onAction="#handleShowApiHelp" styleClass="btn-outline" text="⚙️ AI Setup Guide" />
         </children>
      </HBox>

      <!-- Main Tabs: Tab 1 = AI Chat & Vision, Tab 2 = Offline FAQ Base -->
      <TabPane fx:id="mainTabPane" style="-fx-background-color: transparent;" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
         <tabs>
            <!-- TAB 1: AI Chat & Image Analysis -->
            <Tab text="💬 Live AI Assistant &amp; Vision">
               <content>
                  <HBox spacing="14.0" style="-fx-padding: 10 0 0 0;">
                     <children>
                        <!-- LEFT COLUMN: Chat Interface -->
                        <VBox spacing="10.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 10; -fx-padding: 14; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.04), 8, 0, 0, 2);" HBox.hgrow="ALWAYS">
                           <children>
                              <HBox alignment="CENTER_LEFT" spacing="10.0">
                                 <children>
                                    <Label style="-fx-font-size: 14.5px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" text="Conversation &amp; Analysis History" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Button onAction="#handleClearChat" styleClass="btn-outline" text="🧹 Clear Chat" />
                                 </children>
                              </HBox>

                              <!-- Chat Scroll Pane -->
                              <ScrollPane fx:id="chatScrollPane" fitToWidth="true" style="-fx-background-color: #F8FAFC; -fx-background: #F8FAFC; -fx-border-color: #E2E8F0; -fx-border-radius: 8; -fx-background-radius: 8;" VBox.vgrow="ALWAYS">
                                 <content>
                                    <VBox fx:id="chatContainer" spacing="14.0" style="-fx-padding: 12;">
                                       <children>
                                          <!-- Dynamic Message Bubbles appended here -->
                                       </children>
                                    </VBox>
                                 </content>
                              </ScrollPane>

                              <!-- Loading / Processing Bar -->
                              <HBox fx:id="chatLoadingBox" alignment="CENTER_LEFT" managed="false" spacing="8.0" visible="false">
                                 <children>
                                    <ProgressIndicator prefHeight="18.0" prefWidth="18.0" />
                                    <Label fx:id="chatLoadingLabel" style="-fx-font-size: 12px; -fx-text-fill: #2563EB; -fx-font-style: italic;" text="Analyzing inquiry with AI..." />
                                 </children>
                              </HBox>

                              <!-- Chat Input Bar -->
                              <HBox alignment="CENTER" spacing="10.0">
                                 <children>
                                    <TextField fx:id="chatInputField" onAction="#handleSendMessage" prefHeight="42.0" promptText="Type a question regarding cattle care, milk boiling, curd, hygiene..." style="-fx-font-size: 13.5px;" HBox.hgrow="ALWAYS" />
                                    <Button fx:id="sendBtn" defaultButton="true" onAction="#handleSendMessage" prefHeight="42.0" prefWidth="95.0" styleClass="btn-primary" text="➤ Send" />
                                 </children>
                              </HBox>
                           </children>
                        </VBox>

                        <!-- RIGHT COLUMN: Vision Image Analysis Panel -->
                        <VBox maxWidth="420.0" minWidth="340.0" prefWidth="380.0" spacing="12.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 10; -fx-padding: 16; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.04), 8, 0, 0, 2);">
                           <children>
                              <Label style="-fx-font-size: 15.5px; -fx-font-weight: bold; -fx-text-fill: #0F172A;" text="📸 Vision Image Analysis" />
                              <Label style="-fx-font-size: 12px; -fx-text-fill: #64748B;" text="Upload a photo for genuine visual feature inspection." />

                              <!-- Step 1: Category Selection -->
                              <VBox spacing="6.0" style="-fx-background-color: #F8FAFC; -fx-padding: 10; -fx-background-radius: 8; -fx-border-color: #E2E8F0; -fx-border-radius: 8;">
                                 <children>
                                    <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #334155;" text="1. Select Inspection Category:" />
                                    <RadioButton fx:id="radioAnimalHealth" selected="true" style="-fx-font-size: 12.5px;" text="🐮 Cow/buffalo health concerns" />
                                    <RadioButton fx:id="radioMilkProblems" style="-fx-font-size: 12.5px;" text="🥛 Milk-related problems" />
                                 </children>
                              </VBox>

                              <!-- Step 2: Upload Image & Preview Box -->
                              <VBox spacing="8.0">
                                 <children>
                                    <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #334155;" text="2. Choose Image (JPG, JPEG, PNG):" />
                                    <HBox spacing="8.0">
                                       <children>
                                          <Button fx:id="uploadImageBtn" onAction="#handleUploadImage" prefHeight="36.0" styleClass="btn-primary" text="📁 Upload Image..." HBox.hgrow="ALWAYS" />
                                          <Button fx:id="removeImageBtn" disable="true" onAction="#handleRemoveImage" prefHeight="36.0" styleClass="btn-danger" text="✕ Remove" />
                                       </children>
                                    </HBox>

                                    <!-- Image Preview Container -->
                                    <StackPane fx:id="imagePreviewContainer" prefHeight="165.0" styleClass="image-preview-box">
                                       <children>
                                          <VBox fx:id="emptyPreviewPlaceholder" alignment="CENTER" spacing="6.0">
                                             <children>
                                                <Label style="-fx-font-size: 26px;" text="🖼️" />
                                                <Label style="-fx-text-fill: #94A3B8; -fx-font-size: 12px;" text="No image selected" />
                                                <Label style="-fx-text-fill: #CBD5E1; -fx-font-size: 11px;" text="Click 'Upload Image' to choose a photo" />
                                             </children>
                                          </VBox>
                                          <ImageView fx:id="imagePreviewView" fitHeight="155.0" fitWidth="330.0" preserveRatio="true" smooth="true" visible="false" />
                                       </children>
                                    </StackPane>
                                    <Label fx:id="imageDetailsLabel" style="-fx-font-size: 11px; -fx-text-fill: #64748B;" text="Supported formats: JPG, JPEG, PNG (max 10 MB)" />
                                 </children>
                              </VBox>

                              <!-- Step 3: Observation Notes -->
                              <VBox spacing="4.0">
                                 <children>
                                    <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #334155;" text="3. Additional Observation Notes (Optional):" />
                                    <TextField fx:id="imageNotesField" prefHeight="36.0" promptText="e.g. Swelling on flank, foul odor, milk curdling on boil..." />
                                 </children>
                              </VBox>

                              <!-- Analyze Button -->
                              <Button fx:id="analyzeImageBtn" disable="true" onAction="#handleAnalyzeImage" prefHeight="42.0" prefWidth="Infinity" styleClass="btn-success" text="🔍 Analyze Image with AI" />

                              <!-- Safety & Medical Disclaimer Banner -->
                              <VBox spacing="4.0" style="-fx-background-color: #FEF2F2; -fx-border-color: #FCA5A5; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10;">
                                 <children>
                                    <Label style="-fx-text-fill: #991B1B; -fx-font-size: 11.5px; -fx-font-weight: bold;" text="⚠️ MANDATORY SAFETY NOTICE" />
                                    <Label style="-fx-text-fill: #7F1D1D; -fx-font-size: 10.5px;" text="• Animal results are observational only and NOT a veterinary diagnosis. Always consult a certified veterinarian.&#10;• Milk safety and bacterial purity cannot be confirmed from a photo alone; laboratory testing is required." wrapText="true" />
                                 </children>
                              </VBox>
                           </children>
                        </VBox>
                     </children>
                  </HBox>
               </content>
            </Tab>

            <!-- TAB 2: Offline Knowledge Base Directory -->
            <Tab text="📚 Offline FAQ Directory">
               <content>
                  <VBox spacing="12.0" style="-fx-padding: 10 0 0 0;">
                     <children>
                        <!-- Top Search Bar -->
                        <VBox spacing="10.0" style="-fx-background-color: #FFFFFF; -fx-padding: 16; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.04), 6, 0, 0, 2);">
                           <children>
                              <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" text="📚 Offline Dairy Knowledge Base" />
                              <Label style="-fx-text-fill: #64748B; -fx-font-size: 12.5px;" text="Local keyword search for milk hygiene, boiling guidelines, paneer &amp; ghee storage. Always available offline." />
                              <HBox spacing="12.0">
                                 <children>
                                    <TextField fx:id="searchField" onAction="#handleSearch" prefHeight="38.0" promptText="Type question or keywords (e.g. paneer fridge storage, boiling cow milk...)" HBox.hgrow="ALWAYS" />
                                    <ComboBox fx:id="categoryComboBox" prefHeight="38.0" prefWidth="180.0" promptText="All Categories" />
                                    <Button onAction="#handleSearch" prefHeight="38.0" styleClass="btn-primary" text="🔍 Search FAQ" />
                                    <Button onAction="#handleShowAll" prefHeight="38.0" styleClass="btn-secondary" text="Show All" />
                                 </children>
                              </HBox>
                           </children>
                        </VBox>

                        <!-- Scrollable Answers List -->
                        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
                           <content>
                              <VBox fx:id="faqResultsContainer" spacing="12.0">
                                 <padding>
                                    <Insets bottom="10.0" left="5.0" right="5.0" top="5.0" />
                                 </padding>
                              </VBox>
                           </content>
                        </ScrollPane>
                     </children>
                  </VBox>
               </content>
            </Tab>
         </tabs>
      </TabPane>
   </children>
</VBox>
