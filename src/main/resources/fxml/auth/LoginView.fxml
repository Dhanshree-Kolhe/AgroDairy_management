<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<StackPane styleClass="login-bg" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.agrodairy.management.controller.LoginController">
   <children>
      <VBox alignment="CENTER" maxWidth="480.0" spacing="22.0" styleClass="login-card">
         <children>
            <!-- Logo & Brand Header -->
            <VBox alignment="CENTER" spacing="6.0">
               <children>
                  <HBox alignment="CENTER" spacing="10.0">
                     <children>
                        <Label style="-fx-font-size: 32px;" text="🥛" />
                        <Label style="-fx-text-fill: #1E293B; -fx-font-size: 28px; -fx-font-weight: bold; -fx-letter-spacing: -0.5px;" text="AgroDairy" />
                     </children>
                  </HBox>
                  <Label style="-fx-text-fill: #64748B; -fx-font-size: 13px; -fx-font-weight: bold;" text="ENTERPRISE DAIRY MANAGEMENT SYSTEM" />
                  <Label style="-fx-text-fill: #94A3B8; -fx-font-size: 12px;" text="Doorstep Delivery • Smart Ledger • Operations Hub" />
               </children>
            </VBox>
            
            <Separator prefWidth="200.0" />
            
            <!-- Credentials Input Fields -->
            <VBox alignment="CENTER_LEFT" spacing="14.0">
               <children>
                  <VBox spacing="6.0">
                     <children>
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #334155; -fx-font-size: 13px;" text="Username or Account ID:" />
                        <TextField fx:id="usernameField" prefHeight="40.0" promptText="Enter your username (e.g. admin_super, vendor_ramesh)" />
                     </children>
                  </VBox>
                  
                  <VBox spacing="6.0">
                     <children>
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #334155; -fx-font-size: 13px;" text="Password:" />
                        <HBox alignment="CENTER_LEFT" spacing="6.0">
                           <children>
                              <StackPane HBox.hgrow="ALWAYS">
                                 <children>
                                    <PasswordField fx:id="passwordField" prefHeight="40.0" promptText="Enter your password" />
                                    <TextField fx:id="passwordTextField" prefHeight="40.0" promptText="Enter your password" />
                                 </children>
                              </StackPane>
                              <Button fx:id="togglePasswordBtn" minWidth="75.0" onAction="#handleTogglePassword" prefHeight="40.0" styleClass="btn-secondary" text="👁️ Show" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>

                  <Label fx:id="errorLabel" style="-fx-text-fill: #DC2626; -fx-font-size: 12px; -fx-font-weight: bold; -fx-background-color: #FEF2F2; -fx-border-color: #FCA5A5; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8 12;" wrapText="true" />
               </children>
            </VBox>

            <!-- Sign In Action Button -->
            <Button fx:id="loginButton" defaultButton="true" maxWidth="1.7976931348623157E308" onAction="#handleLogin" prefHeight="44.0" styleClass="btn-primary" text="SIGN IN TO PORTAL">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Button>

            <!-- Presentation Quick Demo Access -->
            <VBox alignment="CENTER" spacing="10.0" style="-fx-background-color: #F8FAFC; -fx-padding: 14; -fx-background-radius: 8; -fx-border-color: #E2E8F0; -fx-border-radius: 8;">
               <children>
                  <Label style="-fx-text-fill: #475569; -fx-font-size: 11px; -fx-font-weight: bold;" text="DEMO PRESENTATION ACCESS (1-CLICK AUTOFILL):" />
                  <HBox alignment="CENTER" spacing="8.0">
                     <children>
                        <Button onAction="#handleFillAdminDemo" styleClass="btn-secondary" text="🛡️ Admin" />
                        <Button onAction="#handleFillVendorDemo" styleClass="btn-secondary" text="🏢 Vendor" />
                        <Button onAction="#handleFillCustomerDemo" styleClass="btn-secondary" text="👤 Customer" />
                     </children>
                  </HBox>
               </children>
            </VBox>

            <Label style="-fx-text-fill: #94A3B8; -fx-font-size: 11px;" text="AgroDairy Management System v1.0.0 • 100% Offline Capable" />
         </children>
         <padding>
            <Insets bottom="30.0" left="35.0" right="35.0" top="30.0" />
         </padding>
      </VBox>
   </children>
</StackPane>
