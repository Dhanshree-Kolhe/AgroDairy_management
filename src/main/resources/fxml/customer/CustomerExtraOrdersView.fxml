<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.agrodairy.management.controller.CustomerExtraOrdersController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="15.0" />
   </padding>
   <children>
      <SplitPane dividerPositions="0.42" VBox.vgrow="ALWAYS">
         <items>
            <!-- Order Form Container -->
            <VBox spacing="12.0" style="-fx-background-color: #FFFFFF; -fx-padding: 18;">
               <children>
                  <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" text="Order Extra Dairy Products" />
                  <Label style="-fx-text-fill: #64748B; -fx-font-size: 12px;" text="Paneer (KG), Curd (KG), Ghee (KG), Butter (GRAM), Cheese (PACKET)" wrapText="true" />
                  <Separator />

                  <Label style="-fx-font-weight: bold;" text="Select Dairy Product *" />
                  <ComboBox fx:id="productComboBox" maxWidth="1.7976931348623157E308" promptText="Select Product" />

                  <Label style="-fx-font-weight: bold;" text="Quantity *" />
                  <TextField fx:id="quantityField" promptText="e.g. 1.0 (in Product Unit)" />

                  <Label style="-fx-font-weight: bold;" text="Delivery Date *" />
                  <DatePicker fx:id="deliveryDatePicker" maxWidth="1.7976931348623157E308" />

                  <Button maxWidth="1.7976931348623157E308" onAction="#handlePlaceOrder" prefHeight="40.0" styleClass="btn-primary" text="🛒 Place Extra Order" />
               </children>
            </VBox>

            <!-- Table Container -->
            <VBox style="-fx-background-color: #FFFFFF; -fx-padding: 10;">
               <children>
                  <TableView fx:id="ordersTable" VBox.vgrow="ALWAYS">
                     <columns>
                        <TableColumn fx:id="colOrderId" prefWidth="80.0" text="Order ID" />
                        <TableColumn fx:id="colProductName" prefWidth="140.0" text="Product" />
                        <TableColumn fx:id="colQty" prefWidth="90.0" text="Quantity" />
                        <TableColumn fx:id="colSnapshotPrice" prefWidth="110.0" text="Price Snapshot" />
                        <TableColumn fx:id="colTotal" prefWidth="110.0" text="Total (₹)" />
                        <TableColumn fx:id="colDeliveryDate" prefWidth="110.0" text="Delivery Date" />
                        <TableColumn fx:id="colStatus" prefWidth="100.0" text="Status" />
                     </columns>
                  </TableView>
               </children>
            </VBox>
         </items>
      </SplitPane>
   </children>
</VBox>
