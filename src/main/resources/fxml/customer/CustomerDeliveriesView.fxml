<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.agrodairy.management.controller.CustomerDeliveriesController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="15.0" />
   </padding>
   <children>
      <!-- Action Bar -->
      <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-background-color: #FFFFFF; -fx-padding: 12; -fx-background-radius: 8;">
         <children>
            <Label style="-fx-font-weight: bold;" text="Select Month:" />
            <ComboBox fx:id="monthComboBox" prefWidth="120.0" />
            <Label style="-fx-font-weight: bold;" text="Year:" />
            <TextField fx:id="yearField" prefWidth="80.0" text="2026" />
            <Button onAction="#loadDeliveries" styleClass="btn-primary" text="🔍 View History" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="totalQtyLabel" style="-fx-font-weight: bold; -fx-text-fill: #2563EB; -fx-font-size: 14px;" text="Total Delivered Qty: -- L" />
         </children>
      </HBox>

      <!-- Table -->
      <VBox style="-fx-background-color: #FFFFFF; -fx-padding: 15; -fx-background-radius: 8;" VBox.vgrow="ALWAYS">
         <children>
            <TableView fx:id="deliveriesTable" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colDate" prefWidth="120.0" text="Date" />
                  <TableColumn fx:id="colShift" prefWidth="110.0" text="Shift" />
                  <TableColumn fx:id="colQty" prefWidth="130.0" text="Delivered Qty (L)" />
                  <TableColumn fx:id="colRate" prefWidth="130.0" text="Price Snapshot (₹/L)" />
                  <TableColumn fx:id="colTotal" prefWidth="140.0" text="Amount (₹)" />
                  <TableColumn fx:id="colStatus" prefWidth="140.0" text="Status" />
                  <TableColumn fx:id="colRemarks" prefWidth="200.0" text="Remarks" />
               </columns>
            </TableView>
         </children>
      </VBox>
   </children>
</VBox>
