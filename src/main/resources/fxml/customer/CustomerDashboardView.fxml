<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.agrodairy.management.controller.CustomerDashboardController">
   <content>
      <VBox spacing="18.0">
         <padding>
            <Insets bottom="25.0" left="22.0" right="22.0" top="18.0" />
         </padding>
         <children>
            <!-- 1. Header Banner -->
            <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #FFFFFF; -fx-padding: 16 20; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 8, 0, 0, 2);">
               <children>
                  <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <Label fx:id="welcomeBannerLabel" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #0F172A;" text="Welcome back, Customer" />
                              <Label fx:id="planStatusBadge" styleClass="badge-success" text="ACTIVE SUBSCRIPTION" />
                           </children>
                        </HBox>
                        <Label fx:id="addressLabel" style="-fx-text-fill: #64748B; -fx-font-size: 13px;" text="Delivery Address: Dharampeth, Nagpur" />
                     </children>
                  </VBox>
                  <HBox alignment="CENTER" spacing="10.0">
                     <children>
                        <Label fx:id="unreadNotificationsLabel" styleClass="badge-info" text="0 Alerts" />
                        <Button onAction="#refreshDashboard" prefHeight="34.0" styleClass="btn-secondary" text="🔄 Refresh" />
                     </children>
                  </HBox>
               </children>
            </HBox>
            
            <!-- 2. KPI Metric Cards Grid -->
            <GridPane hgap="14.0" vgap="14.0">
               <columnConstraints>
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
               </columnConstraints>
               <rowConstraints>
                  <RowConstraints minHeight="95.0" prefHeight="105.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="95.0" prefHeight="105.0" vgrow="SOMETIMES" />
               </rowConstraints>
               <children>
                  <!-- Card 1: Today's Delivery Status -->
                  <VBox styleClass="kpi-card, card-green" GridPane.columnIndex="0" GridPane.rowIndex="0">
                     <children>
                        <Label styleClass="kpi-title" text="TODAY'S DELIVERY STATUS" />
                        <Label fx:id="deliveryStatusLabel" styleClass="kpi-value" text="DELIVERED" />
                        <Label fx:id="subscriptionQtyLabel" styleClass="kpi-subtext" text="Scheduled: 1.5 L Cow Milk" />
                     </children>
                  </VBox>

                  <!-- Card 2: Current Monthly Bill -->
                  <VBox styleClass="kpi-card, card-blue" GridPane.columnIndex="1" GridPane.rowIndex="0">
                     <children>
                        <Label styleClass="kpi-title" text="CURRENT MONTHLY BILL" />
                        <Label fx:id="monthlyBillLabel" styleClass="kpi-value" text="₹0.00" />
                        <Label fx:id="billingPeriodSubtext" styleClass="kpi-subtext" text="Net bill statement" />
                     </children>
                  </VBox>

                  <!-- Card 3: Outstanding Balance Due & Quick Pay -->
                  <VBox styleClass="kpi-card, card-red" GridPane.columnIndex="2" GridPane.rowIndex="0">
                     <children>
                        <HBox alignment="CENTER_LEFT">
                           <children>
                              <Label styleClass="kpi-title" text="BALANCE DUE" />
                              <Region HBox.hgrow="ALWAYS" />
                              <Label fx:id="paymentStatusLabel" styleClass="badge-danger" text="UNPAID" />
                           </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <Label fx:id="balanceDueLabel" styleClass="kpi-value" text="₹0.00" />
                              <Region HBox.hgrow="ALWAYS" />
                              <Button fx:id="btnQuickPay" onAction="#handleQuickPay" styleClass="btn-sm" style="-fx-background-color: #DC2626; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 5 12; -fx-background-radius: 6;" text="💳 Pay Now" />
                           </children>
                        </HBox>
                        <Label fx:id="dueStatusNotice" style="-fx-text-fill: #DC2626; -fx-font-weight: bold; -fx-font-size: 11.5px;" text="Pending clearance" />
                     </children>
                  </VBox>

                  <!-- Card 4: Daily Quota & Milk Plan -->
                  <VBox styleClass="kpi-card, card-purple" GridPane.columnIndex="0" GridPane.rowIndex="1">
                     <children>
                        <Label styleClass="kpi-title" text="SUBSCRIPTION PLAN" />
                        <Label fx:id="dailyQuotaLabel" styleClass="kpi-value" text="2.5 L / Day" />
                        <Label fx:id="milkRateSubtext" styleClass="kpi-subtext" text="Pure Cow Milk" />
                     </children>
                  </VBox>

                  <!-- Card 5: Extra Dairy Orders -->
                  <VBox styleClass="kpi-card, card-orange" GridPane.columnIndex="1" GridPane.rowIndex="1">
                     <children>
                        <Label styleClass="kpi-title" text="EXTRA DAIRY ORDERS" />
                        <Label fx:id="extraOrdersCountLabel" styleClass="kpi-value" text="0 Orders" />
                        <Label styleClass="kpi-subtext" text="Paneer, Curd, Ghee Orders" />
                     </children>
                  </VBox>

                  <!-- Card 6: Quick Short-cut Actions -->
                  <VBox alignment="CENTER_LEFT" spacing="8.0" styleClass="kpi-card" GridPane.columnIndex="2" GridPane.rowIndex="1">
                     <children>
                        <Label style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: #475569;" text="QUICK PORTAL ACTIONS" />
                        <HBox spacing="8.0">
                           <children>
                              <Button onAction="#handleNavBills" styleClass="btn-secondary" text="💳 My Bills" />
                              <Button onAction="#handleNavExtraOrders" styleClass="btn-secondary" text="🛒 Order Extra" />
                              <Button onAction="#handleNavHoliday" styleClass="btn-secondary" text="🌴 Pause" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </children>
            </GridPane>

            <!-- 3. Tables Row (Side by Side Delivery & Bill Summaries) -->
            <GridPane hgap="16.0" vgap="14.0">
               <columnConstraints>
                  <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" prefWidth="50.0" />
                  <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" prefWidth="50.0" />
               </columnConstraints>
               <rowConstraints>
                  <RowConstraints minHeight="260.0" prefHeight="290.0" vgrow="SOMETIMES" />
               </rowConstraints>
               <children>
                  <!-- Left Table: Recent Deliveries -->
                  <VBox spacing="10.0" style="-fx-background-color: #FFFFFF; -fx-padding: 16; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 8, 0, 0, 2);" GridPane.columnIndex="0">
                     <children>
                        <HBox alignment="CENTER_LEFT">
                           <children>
                              <Label style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #1E293B;" text="🚚 Recent Milk Deliveries" />
                              <Region HBox.hgrow="ALWAYS" />
                              <Button onAction="#handleNavDeliveries" styleClass="btn-sm, btn-secondary" text="View All &gt;" />
                           </children>
                        </HBox>
                        <TableView fx:id="recentDeliveriesTable" VBox.vgrow="ALWAYS">
                           <columns>
                              <TableColumn fx:id="colDelDate" prefWidth="95.0" text="Date" />
                              <TableColumn fx:id="colDelShift" prefWidth="85.0" text="Shift" />
                              <TableColumn fx:id="colDelQty" prefWidth="80.0" text="Qty (L)" />
                              <TableColumn fx:id="colDelTotal" prefWidth="85.0" text="Total (₹)" />
                              <TableColumn fx:id="colDelStatus" prefWidth="95.0" text="Status" />
                           </columns>
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy>
                        </TableView>
                     </children>
                  </VBox>

                  <!-- Right Table: Recent Monthly Bills -->
                  <VBox spacing="10.0" style="-fx-background-color: #FFFFFF; -fx-padding: 16; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 8, 0, 0, 2);" GridPane.columnIndex="1">
                     <children>
                        <HBox alignment="CENTER_LEFT">
                           <children>
                              <Label style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #1E293B;" text="📑 Monthly Bill Invoices" />
                              <Region HBox.hgrow="ALWAYS" />
                              <Button onAction="#handleNavBills" styleClass="btn-sm, btn-secondary" text="View All &gt;" />
                           </children>
                        </HBox>
                        <TableView fx:id="recentBillsTable" VBox.vgrow="ALWAYS">
                           <columns>
                              <TableColumn fx:id="colDashBillNum" prefWidth="120.0" text="Bill Number" />
                              <TableColumn fx:id="colDashBillPeriod" prefWidth="75.0" text="Period" />
                              <TableColumn fx:id="colDashBillNet" prefWidth="85.0" text="Net (₹)" />
                              <TableColumn fx:id="colDashBillDue" prefWidth="85.0" text="Due (₹)" />
                              <TableColumn fx:id="colDashBillStatus" prefWidth="80.0" text="Status" />
                              <TableColumn fx:id="colDashBillAction" prefWidth="75.0" text="Action" />
                           </columns>
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy>
                        </TableView>
                     </children>
                  </VBox>
               </children>
            </GridPane>
         </children>
      </VBox>
   </content>
</ScrollPane>
