<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.agrodairy.management.controller.CustomerDashboardController">
   <content>
      <VBox spacing="20.0">
         <padding>
            <Insets bottom="25.0" left="25.0" right="25.0" top="20.0" />
         </padding>
         <children>
            <!-- Header Banner -->
            <HBox alignment="CENTER_LEFT" spacing="15.0">
               <children>
                  <VBox spacing="3.0">
                     <children>
                        <Label fx:id="welcomeBannerLabel" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #0F172A;" text="My Milk Subscription Overview" />
                        <Label fx:id="addressLabel" style="-fx-text-fill: #64748B; -fx-font-size: 13px;" text="Delivery Address: Dharampeth, Nagpur" />
                     </children>
                  </VBox>
               </children>
            </HBox>
            
            <!-- 5 KPI Cards Grid -->
            <GridPane hgap="15.0" vgap="15.0">
               <columnConstraints>
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
               </columnConstraints>
               <rowConstraints>
                  <RowConstraints minHeight="10.0" prefHeight="100.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="100.0" vgrow="SOMETIMES" />
               </rowConstraints>
               <children>
                  <!-- 1. Today's Delivery Status -->
                  <VBox styleClass="kpi-card, card-green" GridPane.columnIndex="0" GridPane.rowIndex="0">
                     <children>
                        <Label styleClass="kpi-title" text="TODAY'S DELIVERY STATUS" />
                        <Label fx:id="deliveryStatusLabel" styleClass="kpi-value" text="DELIVERED" />
                        <Label fx:id="subscriptionQtyLabel" styleClass="kpi-subtext" text="Scheduled: 1.5 L Cow Milk" />
                     </children>
                  </VBox>

                  <!-- 2. Monthly Bill -->
                  <VBox styleClass="kpi-card, card-blue" GridPane.columnIndex="1" GridPane.rowIndex="0">
                     <children>
                        <Label styleClass="kpi-title" text="CURRENT MONTHLY BILL" />
                        <Label fx:id="monthlyBillLabel" styleClass="kpi-value" text="₹0.00" />
                        <Label styleClass="kpi-subtext" text="Net Payable Amount" />
                     </children>
                  </VBox>

                  <!-- 3. Payment Status -->
                  <VBox styleClass="kpi-card, card-purple" GridPane.columnIndex="2" GridPane.rowIndex="0">
                     <children>
                        <Label styleClass="kpi-title" text="PAYMENT STATUS" />
                        <Label fx:id="paymentStatusLabel" styleClass="kpi-value" text="PAID" />
                        <Label fx:id="balanceDueLabel" styleClass="kpi-subtext" text="Balance Due: ₹0.00" />
                     </children>
                  </VBox>

                  <!-- 4. Extra Orders -->
                  <VBox styleClass="kpi-card, card-orange" GridPane.columnIndex="0" GridPane.rowIndex="1">
                     <children>
                        <Label styleClass="kpi-title" text="EXTRA ORDERS" />
                        <Label fx:id="extraOrdersCountLabel" styleClass="kpi-value" text="0 Orders" />
                        <Label styleClass="kpi-subtext" text="Paneer, Curd, Ghee Orders" />
                     </children>
                  </VBox>

                  <!-- 5. Notifications -->
                  <VBox styleClass="kpi-card, card-red" GridPane.columnIndex="1" GridPane.rowIndex="1">
                     <children>
                        <Label styleClass="kpi-title" text="NOTIFICATIONS" />
                        <Label fx:id="unreadNotificationsLabel" styleClass="kpi-value" text="0 Unread" />
                        <Label styleClass="kpi-subtext" text="Important Vendor Alerts" />
                     </children>
                  </VBox>

                  <VBox alignment="CENTER" spacing="8.0" styleClass="kpi-card" GridPane.columnIndex="2" GridPane.rowIndex="1">
                     <children>
                        <Label style="-fx-font-weight: bold; -fx-font-size: 12px;" text="QUICK CUSTOMER ACTIONS" />
                        <HBox alignment="CENTER" spacing="8.0">
                           <children>
                              <Button onAction="#refreshDashboard" styleClass="btn-secondary" text="🔄 Refresh" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </children>
            </GridPane>
         </children>
      </VBox>
   </content>
</ScrollPane>
