<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="16.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.agrodairy.management.controller.CustomerBillsController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="15.0" />
   </padding>
   <children>
      <!-- Header Banner & Summary KPI Strip -->
      <GridPane hgap="14.0" vgap="10.0">
         <columnConstraints>
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
         </columnConstraints>
         <rowConstraints>
            <RowConstraints minHeight="70.0" prefHeight="80.0" vgrow="SOMETIMES" />
         </rowConstraints>
         <children>
            <!-- 1. Total Invoiced Amount -->
            <VBox styleClass="kpi-card, card-blue" GridPane.columnIndex="0">
               <children>
                  <Label styleClass="kpi-title" text="TOTAL INVOICED" />
                  <Label fx:id="totalBilledLabel" styleClass="kpi-value" text="₹0.00" />
                  <Label styleClass="kpi-subtext" text="Gross billing history" />
               </children>
            </VBox>

            <!-- 2. Total Paid -->
            <VBox styleClass="kpi-card, card-green" GridPane.columnIndex="1">
               <children>
                  <Label styleClass="kpi-title" text="TOTAL SETTLED" />
                  <Label fx:id="totalPaidLabel" styleClass="kpi-value" text="₹0.00" />
                  <Label styleClass="kpi-subtext" text="Total payments recorded" />
               </children>
            </VBox>

            <!-- 3. Outstanding Balance -->
            <VBox styleClass="kpi-card, card-red" GridPane.columnIndex="2">
               <children>
                  <Label styleClass="kpi-title" text="OUTSTANDING BALANCE" />
                  <Label fx:id="totalDueLabel" styleClass="kpi-value" text="₹0.00" />
                  <Label fx:id="dueStatusSubtext" style="-fx-text-fill: #DC2626; -fx-font-weight: bold; -fx-font-size: 11.5px;" text="Pending clearance" />
               </children>
            </VBox>

            <!-- 4. Bills Count & Status -->
            <VBox styleClass="kpi-card, card-purple" GridPane.columnIndex="3">
               <children>
                  <Label styleClass="kpi-title" text="BILL STATEMENTS" />
                  <Label fx:id="pendingCountLabel" styleClass="kpi-value" text="0 Statements" />
                  <Label fx:id="pendingBillsSubtext" styleClass="kpi-subtext" text="0 bills pending payment" />
               </children>
            </VBox>
         </children>
      </GridPane>

      <!-- Action & Filter Bar -->
      <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-background-color: #FFFFFF; -fx-padding: 12 16; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 8, 0, 0, 2);">
         <children>
            <Label style="-fx-font-weight: bold; -fx-text-fill: #475569; -fx-font-size: 13px;" text="Filter Status:" />
            <ComboBox fx:id="statusFilterCombo" prefHeight="36.0" prefWidth="140.0" promptText="Filter by status" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnPaySelected" onAction="#handlePaySelectedBill" prefHeight="36.0" styleClass="btn-success" text="💳 Pay Now" />
            <Button onAction="#handleViewPaymentHistory" prefHeight="36.0" styleClass="btn-primary" text="📋 Payment History" />
            <Button onAction="#handleExportPdfInvoice" prefHeight="36.0" styleClass="btn-info" text="📄 Download Invoice PDF" />
            <Button onAction="#loadBills" prefHeight="36.0" styleClass="btn-secondary" text="🔄 Refresh" />
         </children>
      </HBox>

      <!-- Bills Table Section -->
      <VBox style="-fx-background-color: #FFFFFF; -fx-padding: 16; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 8, 0, 0, 2);" VBox.vgrow="ALWAYS">
         <children>
            <TableView fx:id="billsTable" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colBillNum" prefWidth="140.0" text="Bill Number" />
                  <TableColumn fx:id="colPeriod" prefWidth="95.0" text="Period" />
                  <TableColumn fx:id="colMilkQty" prefWidth="100.0" text="Milk (L)" />
                  <TableColumn fx:id="colMilkChg" prefWidth="105.0" text="Milk Charges" />
                  <TableColumn fx:id="colExtraChg" prefWidth="100.0" text="Extra Orders" />
                  <TableColumn fx:id="colNet" prefWidth="115.0" text="Net Payable" />
                  <TableColumn fx:id="colPaid" prefWidth="105.0" text="Amount Paid" />
                  <TableColumn fx:id="colDue" prefWidth="115.0" text="Balance Due" />
                  <TableColumn fx:id="colStatus" prefWidth="100.0" text="Status" />
                  <TableColumn fx:id="colAction" prefWidth="120.0" text="Payment Action" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
   </children>
</VBox>
