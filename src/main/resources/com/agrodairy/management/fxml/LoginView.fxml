<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<StackPane stylesheets="@../css/styles.css" styleClass="login-bg" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.agrodairy.management.controller.LoginController">
    <VBox alignment="CENTER" maxWidth="450" maxHeight="580" styleClass="login-card" spacing="15">
        <children>
            <!-- Branding Header -->
            <VBox alignment="CENTER" spacing="4">
                <Text text="AgroDairy" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-fill: #10b981;" />
                <Text text="Smart Dairy Management &amp; Customer Portal" style="-fx-font-size: 13px; -fx-fill: #64748b;" />
            </VBox>

            <!-- Role Selector Toggle -->
            <HBox alignment="CENTER" spacing="20" style="-fx-background-color: #f1f5f9; -fx-padding: 10; -fx-background-radius: 8;">
                <fx:define>
                    <ToggleGroup fx:id="roleToggleGroup" />
                </fx:define>
                <children>
                    <RadioButton fx:id="vendorRadio" text="Vendor / Staff Login" toggleGroup="$roleToggleGroup" selected="true" style="-fx-font-weight: bold;" />
                    <RadioButton fx:id="customerRadio" text="Customer Portal" toggleGroup="$roleToggleGroup" style="-fx-font-weight: bold;" />
                </children>
            </HBox>

            <Separator prefWidth="200" />

            <!-- Input Fields -->
            <VBox spacing="12" alignment="CENTER_LEFT">
                <VBox spacing="5">
                    <Label text="Username / Mobile / Email" styleClass="form-label" />
                    <TextField fx:id="usernameField" promptText="Enter username or mobile" prefHeight="40" />
                </VBox>

                <VBox spacing="5">
                    <Label text="Password" styleClass="form-label" />
                    <PasswordField fx:id="passwordField" promptText="Enter password" prefHeight="40" />
                </VBox>

                <HBox alignment="CENTER_LEFT">
                    <CheckBox fx:id="rememberMeCheckBox" text="Remember Me" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Hyperlink text="Forgot Password?" onAction="#handleForgotPassword" style="-fx-text-fill: #3b82f6;" />
                </HBox>
            </VBox>

            <Button text="Sign In" onAction="#handleLogin" prefHeight="44" maxWidth="Infinity" styleClass="btn-primary" />

            <Separator prefWidth="200" />

            <!-- Registration Link for Customers -->
            <HBox alignment="CENTER" spacing="5">
                <Label text="New Household / Business Customer?" style="-fx-text-fill: #64748b;" />
                <Hyperlink text="Register Account" onAction="#handleOpenRegister" style="-fx-font-weight: bold; -fx-text-fill: #10b981;" />
            </HBox>
        </children>
    </VBox>
</StackPane>
