<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.agrodairy.management.controller.MainLayoutController">
    <!-- Top Header -->
    <top>
        <HBox alignment="CENTER_LEFT" styleClass="header-bar" spacing="20">
            <children>
                <Label text="AgroDairy Enterprise" styleClass="header-title" />
                <Region HBox.hgrow="ALWAYS" />
                <VBox alignment="CENTER_RIGHT">
                    <Label fx:id="userLabel" style="-fx-text-fill: #ffffff; -fx-font-weight: bold;" text="User Name" />
                    <Label fx:id="roleLabel" style="-fx-text-fill: #10b981; -fx-font-size: 12px;" text="Role: ADMIN" />
                </VBox>
                <Button text="Logout" onAction="#handleLogout" styleClass="btn-secondary" />
            </children>
        </HBox>
    </top>

    <!-- Sidebar Navigation -->
    <left>
        <VBox styleClass="sidebar">
            <children>
                <Button text="📊 Dashboard" onAction="#showDashboard" maxWidth="Infinity" styleClass="sidebar-button" />
                <Button text="🥛 Milk Collection" onAction="#showMilkCollection" maxWidth="Infinity" styleClass="sidebar-button" />
                <Button text="👨‍🌾 Farmers Directory" onAction="#showFarmers" maxWidth="Infinity" styleClass="sidebar-button" />
                <Button text="👥 Customers Directory" onAction="#showCustomers" maxWidth="Infinity" styleClass="sidebar-button" />
                <Separator style="-fx-padding: 10 0;" />
                <Region VBox.vgrow="ALWAYS" />
                <Label text="System v1.0.0" style="-fx-text-fill: #64748b; -fx-font-size: 11px; -fx-padding: 10;" />
            </children>
        </VBox>
    </left>

    <!-- Center Content Region -->
    <center>
        <StackPane fx:id="contentArea" style="-fx-padding: 20;">
            <!-- Dynamic FXML Views will be injected here -->
        </StackPane>
    </center>
</BorderPane>
