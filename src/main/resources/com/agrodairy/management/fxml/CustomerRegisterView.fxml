<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<StackPane stylesheets="@../css/styles.css" styleClass="login-bg" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.agrodairy.management.controller.CustomerRegisterController">
    <VBox alignment="CENTER" maxWidth="520" maxHeight="650" styleClass="login-card" spacing="15">
        <children>
            <VBox alignment="CENTER" spacing="4">
                <Text text="AgroDairy Customer Portal" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-fill: #10b981;" />
                <Text text="Create your Household / Business Dairy Account" style="-fx-font-size: 13px; -fx-fill: #64748b;" />
            </VBox>

            <Separator prefWidth="200" />

            <GridPane hgap="15" vgap="12">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50" />
                    <ColumnConstraints percentWidth="50" />
                </columnConstraints>
                <children>
                    <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label text="Full Name *" styleClass="form-label" />
                        <TextField fx:id="nameField" promptText="Enter full name" />
                    </VBox>
                    <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label text="Phone Number *" styleClass="form-label" />
                        <TextField fx:id="phoneField" promptText="10-digit mobile" />
                    </VBox>
                    <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <Label text="Email Address" styleClass="form-label" />
                        <TextField fx:id="emailField" promptText="name@example.com" />
                    </VBox>
                    <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <Label text="Subscription Plan" styleClass="form-label" />
                        <ComboBox fx:id="planComboBox" maxWidth="Infinity" />
                    </VBox>
                    <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="2">
                        <Label text="Password *" styleClass="form-label" />
                        <PasswordField fx:id="passwordField" promptText="Min 6 characters" />
                    </VBox>
                    <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="2">
                        <Label text="Confirm Password *" styleClass="form-label" />
                        <PasswordField fx:id="confirmPasswordField" promptText="Re-type password" />
                    </VBox>
                </children>
            </GridPane>

            <VBox spacing="4">
                <Label text="Delivery Address" styleClass="form-label" />
                <TextField fx:id="addressField" promptText="Flat / House No, Street, Apartment, Area, City" />
            </VBox>

            <Button text="Complete Registration" onAction="#handleRegister" prefHeight="44" maxWidth="Infinity" styleClass="btn-primary" />

            <Button text="← Back to Login" onAction="#handleBackToLogin" styleClass="btn-secondary" maxWidth="Infinity" />
        </children>
    </VBox>
</StackPane>
